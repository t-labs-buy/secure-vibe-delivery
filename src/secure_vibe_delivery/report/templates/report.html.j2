<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Secure Vibe Delivery report: {{ project_name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box}
:root{
  color-scheme:light;
  --bg:#f4f4f4;--head-bg:#ededed;--card:#ffffff;--ink:#1c2529;--muted:#56676d;--faint:#898781;
  --accent:#0e6e68;--accent-soft:#eeeeee;--border:#dddddd;--code-bg:#f0f0f0;--code-ink:#1f2328;
  --grid:#e4e4e4;--axis:#c4c4c4;
  --good:#0ca30c;--good-ink:#006300;--warning:#fab219;--serious:#ec835a;--critical:#d03b3b;
  --good-bg:#e8f3ea;--warn-bg:#faf3e0;--bad-bg:#fbeaea;--notrun-bg:#fcefe8;
  --series-1:#2a78d6;--series-2:#eb6834;
  --tab-bg:#e9e7f7;--tab-ink:#4f46b8;--tab-border:#c9c4ec;--shell:#fbfbfb;
  --lift:0 10px 28px rgba(28,37,41,.10);--row-hover:#f5f5f5;
  --tip-bg:#fff9e0;--tip-border:#efdf9f;--tip-rule:#f1e5b4;
  --tl-security:#2a78d6;--tl-functional:#eb6834;--tl-performance:#1baf7a;--tl-setup:#8b9296;--tl-skipped:#fab219;--tl-skipped-ink:#c98a00;
}
@media (prefers-color-scheme:dark){
  :root:where(:not([data-theme="light"])){
    color-scheme:dark;
    --bg:#303446;--head-bg:#292c3c;--card:#414559;--ink:#c6d0f5;--muted:#a5adce;--faint:#949cbb;
    --accent:#81c8be;--accent-soft:#51576d;--border:#51576d;--code-bg:#292c3c;--code-ink:#99d1db;
    --grid:#4a4f63;--axis:#626880;--good-ink:#a6d189;
    --good-bg:#3b4a45;--warn-bg:#4a4536;--bad-bg:#4d3a42;--notrun-bg:#4d4038;
    --series-1:#3987e5;--series-2:#d95926;
    --tab-bg:#454063;--tab-ink:#babbf1;--tab-border:#6c6896;--shell:#3a3e52;
    --lift:0 10px 28px rgba(0,0,0,.35);--row-hover:#464a5e;
    --tip-bg:#4b4838;--tip-border:#6e6848;--tip-rule:#5f5a44;
    --tl-security:#3987e5;--tl-functional:#d95926;--tl-performance:#199e70;--tl-setup:#8c93ad;--tl-skipped:#fab219;--tl-skipped-ink:#a87400;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#303446;--head-bg:#292c3c;--card:#414559;--ink:#c6d0f5;--muted:#a5adce;--faint:#949cbb;
  --accent:#81c8be;--accent-soft:#51576d;--border:#51576d;--code-bg:#292c3c;--code-ink:#99d1db;
  --grid:#4a4f63;--axis:#626880;--good-ink:#a6d189;
  --good-bg:#3b4a45;--warn-bg:#4a4536;--bad-bg:#4d3a42;--notrun-bg:#4d4038;
  --series-1:#3987e5;--series-2:#d95926;
  --tab-bg:#454063;--tab-ink:#babbf1;--tab-border:#6c6896;--shell:#3a3e52;
  --lift:0 10px 28px rgba(0,0,0,.35);--row-hover:#464a5e;
    --tip-bg:#4b4838;--tip-border:#6e6848;--tip-rule:#5f5a44;
    --tl-security:#3987e5;--tl-functional:#d95926;--tl-performance:#199e70;--tl-setup:#8c93ad;--tl-skipped:#fab219;--tl-skipped-ink:#a87400;
}
html{scroll-behavior:smooth;scroll-padding-top:4rem}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.65 "JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace}
a{color:var(--accent)}
code,pre{font-family:inherit;background:var(--code-bg);color:var(--code-ink);border-radius:4px}
code{padding:.05em .35em;font-size:.92em}
pre{padding:.85rem 1.1rem;overflow:auto;font-size:13px;white-space:pre-wrap;word-break:break-word;max-height:22rem}
.wrap{margin:0;padding:0 clamp(16px,2.5vw,44px)}
.eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:700}
h1{font-size:clamp(1.4rem,3vw,2rem);margin:.3rem 0 .4rem;line-height:1.25}
h2{font-size:1.3rem;margin:0 0 .35rem}
h3{font-size:1.05rem;margin:2rem 0 .65rem}
.meta{color:var(--muted);font-size:12.5px;display:flex;flex-wrap:wrap;gap:.25rem 1.25rem}
.tabshell{background:var(--shell);border:1px solid var(--border);border-radius:18px;padding:.5rem clamp(1rem,2vw,2rem) 2rem;margin:1.5rem 0}
.tabbar{display:flex;gap:.25rem;overflow-x:auto;border-bottom:2px solid var(--border);margin:0 0 1.75rem;scrollbar-width:thin;
  position:sticky;top:0;z-index:5;background:var(--shell);padding-top:.6rem}
.tabbar [role=tab]{font:inherit;font-size:13.5px;color:var(--muted);background:none;border:1px solid transparent;border-bottom:0;
  border-radius:10px 10px 0 0;padding:.6rem 1rem;margin-bottom:-2px;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;gap:.4rem;
  transition:background-color .15s ease,color .15s ease}
.tabbar [role=tab]:hover{color:var(--ink);background:var(--accent-soft)}
.tabbar [role=tab][aria-selected=true]{background:var(--tab-bg);color:var(--tab-ink);border-color:var(--tab-border);font-weight:700;
  border-bottom:2px solid var(--tab-bg)}
.tabbar [role=tab]:focus-visible{outline:2px solid var(--tab-ink);outline-offset:-2px}
.tabbar .dot{font-size:11px;font-weight:700}
.tabbar .dot.PASS{color:var(--good)}.tabbar .dot.FAIL{color:var(--critical)}.tabbar .dot.NOT_RUN{color:var(--serious)}.tabbar .dot.WARN{color:#9a6a00}
.js-tabs section.panel{display:none}
.js-tabs section.panel.active{display:block;animation:panelIn .24s ease both}
@keyframes panelIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
section.panel:focus{outline:none}
.tabshell section.card{background:none;border:0;border-radius:0;padding:0;margin:0}
.pager{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid var(--border);margin-top:2rem;padding-top:1.25rem}
.pager a{color:var(--tab-ink);font-weight:700;text-decoration:none;font-size:14px;padding:.4rem .2rem}
.pager a .arr{display:inline-block;transition:transform .18s ease}
.pager a.next:hover .arr{transform:translateX(4px)}.pager a.prev:hover .arr{transform:translateX(-4px)}
.pager a:hover .txt{text-decoration:underline}
.pager .next{margin-left:auto;text-align:right}
@media (max-width:640px){.tabshell{padding:.75rem .75rem 1.25rem;border-radius:14px}}
button.theme{font:inherit;font-size:13px;background:var(--card);color:var(--ink);border:1px solid var(--border);border-radius:6px;padding:.3rem .7rem;cursor:pointer;white-space:nowrap}
main{padding:1.5rem 0 4rem}
section.card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.5rem;margin:0 0 1.25rem}
.lede{color:var(--muted);margin:.2rem 0 1.25rem;max-width:95ch}
.verdict{display:flex;gap:1.25rem;align-items:center;flex-wrap:wrap;padding:1.5rem 1.75rem;border-radius:14px}
.verdict.NO-GO{background:var(--bad-bg)}
.verdict.PROVISIONAL{background:var(--warn-bg)}
.verdict.GO{background:var(--good-bg)}
.verdict .big{font-size:clamp(1.8rem,5vw,2.6rem);font-weight:800;letter-spacing:.02em;line-height:1}
.verdict .ico{font-size:2rem;width:3rem;height:3rem;display:grid;place-items:center;border-radius:50%;color:#fff;flex:none}
.verdict.NO-GO .ico{background:var(--critical)}.verdict.PROVISIONAL .ico{background:#9a6a00}.verdict.GO .ico{background:var(--good)}
.verdict p{margin:.25rem 0 0;max-width:46rem}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));gap:1.1rem;margin-top:1.25rem}
.tile{border:1px solid var(--border);border-radius:12px;padding:1.1rem 1.2rem;background:var(--card);display:block;color:inherit;text-decoration:none}
a.tile .go{display:inline-block;margin-top:.6rem;font-size:13px;color:var(--accent);font-weight:700}
a.tile .go span{display:inline-block;transition:transform .18s ease}
a.tile:hover .go span{transform:translateX(4px)}
.tile,.kpi,.chartcard,.card-lift{transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease}
.tile:hover,.kpi:hover,.chartcard:hover{transform:translateY(-3px);box-shadow:var(--lift);border-color:var(--axis)}
.tile h4{margin:0 0 .4rem;font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);display:flex;justify-content:space-between;gap:.5rem;align-items:center}
.tile p{margin:.35rem 0 0;font-size:14px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.9rem;margin:1.25rem 0}
.kpi{border:1px solid var(--border);border-radius:12px;padding:.9rem 1.1rem;background:var(--card)}
.kpi .v{font-size:1.75rem;font-weight:700;line-height:1.2}
.kpi .l{font-size:12.5px;color:var(--muted)}
.kpi .d{font-size:12px;margin-top:.2rem}
.badge{display:inline-flex;align-items:center;gap:.35rem;font-size:11.5px;font-weight:700;padding:.1rem .5rem;border-radius:999px;border:1px solid var(--border);white-space:nowrap;background:var(--card);color:var(--ink)}
.badge i{font-style:normal}
.st-PASS{border-color:var(--good)}.st-PASS i{color:var(--good)}
.st-FAIL{border-color:var(--critical)}.st-FAIL i{color:var(--critical)}
.st-WARN{border-color:var(--warning)}.st-WARN i{color:#9a6a00}
.st-NOT_RUN{border-color:var(--serious)}.st-NOT_RUN i{color:var(--serious)}
:root[data-theme="dark"] .st-WARN i{color:var(--warning)}
@media (prefers-color-scheme:dark){:root:where(:not([data-theme="light"])) .st-WARN i{color:var(--warning)}}
.sev{display:inline-flex;align-items:center;gap:.4rem;font-size:12px;white-space:nowrap}
.sev::before{content:"";width:.6rem;height:.6rem;border-radius:2px;background:var(--faint)}
.sev-critical::before{background:var(--critical)}.sev-high::before{background:var(--serious)}
.sev-medium::before{background:var(--warning)}.sev-low::before,.sev-info::before{background:var(--faint)}
.tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:12px;background:var(--card)}
table{border-collapse:collapse;width:100%;font-size:13.5px;line-height:1.55}
th,td{text-align:left;padding:.65rem .8rem;border-bottom:1px solid var(--border);vertical-align:top}
tbody tr{transition:background-color .12s ease}
tbody tr:hover{background:var(--row-hover)}
th{background:var(--bg);font-weight:700;color:var(--muted);font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;position:sticky;top:0}
tr:last-child td{border-bottom:0}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
td .sub{color:var(--muted);font-size:12.5px;display:block;margin-top:.2rem}
.where{color:var(--accent);overflow-wrap:anywhere}
td.where{min-width:13ch}
.tablewrap table{min-width:40rem}
td.issuecol{min-width:30ch}
td.fixcol{min-width:26ch}
.filters{display:flex;gap:.5rem;flex-wrap:wrap;margin:.5rem 0 .75rem}
.filters input,.filters select{font:inherit;font-size:13px;padding:.35rem .6rem;border:1px solid var(--border);border-radius:6px;background:var(--card);color:var(--ink);min-width:0}
.filters input{flex:1 1 14rem}
.chipbar{display:flex;gap:.4rem;flex-wrap:wrap;margin:.25rem 0 .75rem}
.chipbar button{font:inherit;font-size:12.5px;border:1px solid var(--border);background:var(--card);color:var(--ink);border-radius:999px;padding:.3rem .75rem;cursor:pointer;
  transition:background-color .15s ease,border-color .15s ease,transform .15s ease}
.chipbar button:hover{border-color:var(--axis);transform:translateY(-1px)}
.chipbar button[aria-pressed=true]{background:var(--tab-bg);color:var(--tab-ink);border-color:var(--tab-border);font-weight:700}
.chipbar .n{color:var(--muted);margin-left:.3rem;font-weight:400}
.split{display:grid;grid-template-columns:minmax(0,1fr);gap:1.1rem}
@media (min-width:1200px){.split{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.split .wide{grid-column:1/-1}}
.chart .bar{transition:opacity .15s ease}
.chart .row-hit:hover~.bar,.chart g.r:hover .bar{opacity:.85}
.legend i.sw{display:inline-block;width:.7rem;height:.7rem;border-radius:2px}
.tablelink{font-size:12.5px}
.ov-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:1.1rem;margin-top:1.25rem}
@media (min-width:1100px){.ov-grid{grid-template-columns:minmax(18rem,26rem) minmax(0,1fr)}}
.scorecard,.sumcard{border:1px solid var(--border);border-radius:12px;padding:1.2rem 1.3rem;background:var(--card)}
.scorecard h4,.sumcard h4{margin:0 0 .2rem;font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.score-hero{display:flex;align-items:baseline;gap:.6rem;margin:.3rem 0 .2rem}
.score-hero .num{font-size:3.4rem;font-weight:800;line-height:1}
.score-hero .of{color:var(--muted);font-size:1rem}
.grade{display:inline-flex;align-items:center;gap:.4rem;font-weight:700;font-size:13px;padding:.15rem .6rem;border-radius:999px;border:1px solid var(--border);margin-left:auto}
.grade i{font-style:normal;width:.6rem;height:.6rem;border-radius:2px;display:inline-block}
.meter{height:.6rem;border-radius:999px;background:var(--code-bg);overflow:hidden;margin:.55rem 0 .2rem}
.meter b{display:block;height:100%;border-radius:999px}
.band-good{background:var(--good)}.band-warn{background:var(--warning)}.band-bad{background:var(--critical)}
.sc-rows{margin-top:1rem;display:grid;gap:.65rem}
.sc-row .top{display:flex;justify-content:space-between;font-size:13.5px}
.sc-row .top span{color:var(--muted)}
.sc-row .meter{height:.45rem;margin:.3rem 0 0}
.caps{font-size:12.5px;color:var(--muted);margin:.8rem 0 0}
.sumcard .src{font-size:12px;color:var(--muted);margin:0 0 .6rem}
.sumcard .overall{font-size:15px;margin:.2rem 0 1rem}
.sumcols{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1rem}
.sumcols h5{margin:0 0 .4rem;font-size:13px;display:flex;align-items:center;gap:.4rem}
.sumcols ul{margin:0;padding-left:1.1rem;font-size:13.5px}
.sumcols li{margin:.25rem 0}
.sumcols .ok h5 i{color:var(--good)}.sumcols .bad h5 i{color:var(--critical)}.sumcols .first h5 i{color:var(--serious)}
.sumcols h5 i{font-style:normal}
.jt td.k{white-space:nowrap}
.jt .kind{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.jt code{white-space:pre-wrap;word-break:break-all}
.callout{background:var(--accent-soft);padding:.85rem 1.15rem;border-radius:10px;margin:1rem 0;font-size:14px}
.callout.warn{background:var(--warn-bg)}
.callout.bad{background:var(--bad-bg)}
.vtip{position:relative;cursor:help;text-decoration:underline dotted;text-decoration-thickness:2px;text-underline-offset:.18em;outline:none}
.vtip-pop{position:absolute;left:0;top:calc(100% + .5rem);z-index:20;width:min(24rem,80vw);background:var(--card);color:var(--ink);
  border:1px solid var(--border);border-radius:10px;box-shadow:var(--lift);padding:.75rem .9rem;font-size:13px;font-weight:400;
  line-height:1.5;letter-spacing:0;text-transform:none;white-space:normal;opacity:0;visibility:hidden;transform:translateY(-4px);
  transition:opacity .15s ease,transform .15s ease,visibility .15s}
.vtip:hover .vtip-pop,.vtip:focus .vtip-pop,.vtip:focus-within .vtip-pop{opacity:1;visibility:visible;transform:none}
.vtip-all{display:block;margin-top:.5rem;padding-top:.5rem;border-top:1px solid var(--border);color:var(--muted);font-size:12px}
.vtip-all span{display:block}
.vtip-all b{color:var(--ink)}
details.scoremath{margin:1.1rem 0 0;padding:.8rem 1.1rem}
details.scoremath[open]{border-color:var(--axis)}
details.scoremath summary{font-size:14px}
details.scoremath[open] .hint{display:none}
details.scoremath .tablewrap{margin-top:.6rem}
table.hist code.cmd{white-space:pre-wrap;word-break:break-all;cursor:help;display:inline;outline:none;transition:background-color .15s ease}
table.hist code.cmd:hover,table.hist code.cmd:focus{background:var(--accent-soft);color:var(--ink)}
table.hist .tool{font-weight:700;font-size:12.5px}
table.hist td.cmdcell{min-width:24rem}
button.copy{font:inherit;font-size:12px;background:var(--card);color:var(--ink);border:1px solid var(--border);border-radius:6px;
  padding:.2rem .6rem;cursor:pointer;white-space:nowrap;transition:border-color .15s ease,background-color .15s ease}
button.copy:hover{border-color:var(--axis);background:var(--row-hover)}
button.copy.done{border-color:var(--good);color:var(--good-ink)}
.cmdtip{position:fixed;z-index:30;width:min(24rem,86vw);background:var(--tip-bg);color:var(--ink);border:1px solid var(--tip-border);
  border-radius:10px;box-shadow:var(--lift);padding:.75rem .9rem;font-size:13px;line-height:1.5;pointer-events:none}
.cmdtip b{display:block;margin-bottom:.25rem}
.cmdtip .c{display:block;margin-top:.45rem;padding-top:.45rem;border-top:1px solid var(--tip-rule);color:var(--muted);font-size:12px;word-break:break-all}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.codever{border:1px solid var(--border);border-radius:12px;padding:1rem 1.3rem;background:var(--card);margin:1.1rem 0 0}
.codever h4{margin:0 0 .6rem;font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}
.cv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13rem,1fr));gap:.5rem 1.5rem;margin:0}
.cv-grid div{min-width:0}.cv-grid .wide{grid-column:span 2}
@media (max-width:640px){.cv-grid .wide{grid-column:auto}}
.cv-grid dt{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.cv-grid dd{margin:.1rem 0 0;font-size:13.5px;overflow-wrap:anywhere}
.cv-state{display:flex;gap:.6rem;align-items:flex-start;margin-top:.85rem;font-size:13.5px}
.cv-state .badge{flex:none;margin-top:.1rem}
details.cv-files{margin:.7rem 0 0}
details.cv-files pre{margin:.5rem 0 0;max-height:14rem}
.tl-head{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem;flex-wrap:wrap}
.tl-head h2{margin-bottom:.2rem}
.tl-legend{list-style:none;display:flex;flex-wrap:wrap;gap:.4rem 1.1rem;margin:.35rem 0 0;padding:0;font-size:13px;color:var(--muted)}
.tl-legend li{display:flex;align-items:center;gap:.45rem}
.tl-legend .sw{display:inline-block;width:1.1rem;height:.3rem;border-radius:2px}
.tl{margin:1rem 0 .5rem}
.tl-row{display:grid;grid-template-columns:minmax(9rem,15rem) minmax(0,1fr);gap:1rem;align-items:center;margin:0 0 .5rem}
.tl-label{font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tl-track{position:relative;height:1.6rem;background:var(--code-bg);border-radius:7px}
.tl-bar{position:absolute;top:.2rem;bottom:.2rem;min-width:.6rem;border:0;border-radius:5px;padding:0 .45rem;cursor:pointer;
  font:inherit;display:flex;align-items:center;overflow:hidden;transition:filter .15s ease,box-shadow .15s ease}
.tl-bar:hover{filter:brightness(1.08)}
.tl-bar[aria-pressed=true]{box-shadow:0 0 0 2px var(--card),0 0 0 4px var(--ink)}
.tl-bar:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.tl-dur{font-size:12px;white-space:nowrap;color:var(--muted);position:absolute;top:50%;transform:translateY(-50%);pointer-events:none}
.tl-dur.after{margin-left:.4rem}.tl-dur.before{margin-right:.4rem}
.tl-dur.in{position:static;transform:none;color:#fff;font-weight:600}
.tl-security{background:var(--tl-security)}.tl-functional{background:var(--tl-functional)}
.tl-performance{background:var(--tl-performance)}.tl-setup{background:var(--tl-setup)}
.tl-functional .tl-dur.in,.tl-performance .tl-dur.in{color:#14191b}
.tl-skipped{background:repeating-linear-gradient(45deg,var(--tl-skipped) 0 3px,var(--tl-skipped-ink) 3px 5px)}
.tl-skipped .tl-dur.in{color:#14191b;background:var(--tl-skipped);border-radius:3px;padding:0 .25rem}
.tl-legend .sw.tl-skipped{height:.55rem}
.tl-axisrow{margin-top:.15rem}
.tl-axis{position:relative;height:1.2rem;font-size:12px;color:var(--muted)}
.tl-axis span{position:absolute;transform:translateX(-50%);white-space:nowrap}
.tl-axis span.start{transform:none}.tl-axis span.end{transform:translateX(-100%)}
.tl-detail{background:var(--code-bg);border-radius:12px;padding:1rem 1.2rem;margin:1rem 0 1.5rem}
.tl-dtitle{font-size:15px;margin-bottom:.35rem}
.tl-what{margin:.35rem 0;color:var(--muted);font-size:13.5px}
.tl-cmd+.tl-cmd{border-top:1px solid var(--border);margin-top:.6rem;padding-top:.5rem}
.tl-cmdline{display:flex;gap:.8rem;align-items:flex-start;justify-content:space-between}
.tl-cmdline code{background:none;padding:0;white-space:pre-wrap;word-break:break-all;font-size:13px;color:var(--ink)}
.tl-cmdline .copy{flex:none}
@media (max-width:700px){.tl-row{grid-template-columns:minmax(0,1fr);gap:.2rem}.tl-axisrow>div:first-child{display:none}}
.hero{display:grid;grid-template-columns:minmax(0,1fr);gap:1.5rem;align-items:start}
@media (min-width:1100px){.hero{grid-template-columns:minmax(0,1.45fr) minmax(22rem,1fr)}}
.vpill{display:inline-flex;align-items:center;gap:.5rem;font-size:12.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
  padding:.35rem .8rem;border-radius:999px}
.vpill i{width:.5rem;height:.5rem;border-radius:50%;display:inline-block;background:currentColor}
.vpill .vtip{text-decoration-thickness:1px}
.v-PROVISIONAL{background:var(--warn-bg);color:#9a6a00}.v-NO-GO{background:var(--bad-bg);color:var(--critical)}.v-GO{background:var(--good-bg);color:var(--good-ink)}
:root[data-theme="dark"] .v-PROVISIONAL{color:var(--warning)}
@media (prefers-color-scheme:dark){:root:where(:not([data-theme="light"])) .v-PROVISIONAL{color:var(--warning)}}
.hero-h{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Inter,Roboto,sans-serif;font-size:clamp(2.2rem,5.2vw,4.1rem);
  font-weight:800;letter-spacing:-.03em;line-height:1.02;margin:1rem 0 .9rem}
.acc-accent{color:var(--tl-security)}.acc-good{color:var(--good-ink)}.acc-bad{color:var(--critical)}
:root[data-theme="dark"] .acc-good{color:var(--good)}
@media (prefers-color-scheme:dark){:root:where(:not([data-theme="light"])) .acc-good{color:var(--good)}}
.hero-p{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Inter,Roboto,sans-serif;font-size:clamp(1rem,1.5vw,1.2rem);
  line-height:1.55;color:var(--muted);margin:0 0 1.1rem;max-width:44rem}
.hero-meta{display:flex;flex-wrap:wrap;gap:.35rem 1.4rem;font-size:13px;color:var(--muted)}
.hero-meta b{color:var(--ink)}.hero-meta code{background:none;padding:0}
.hero-meta .br{flex-basis:100%}
.hero-meta .hm-path{color:var(--muted);font-size:12px;overflow-wrap:anywhere}
.tb-actions{margin:0 0 .35rem auto;flex:none;align-self:center;display:flex;gap:.4rem;padding-left:.75rem}
.tb-btn{font:inherit;font-size:13px;background:var(--card);color:var(--ink);border:1px solid var(--border);border-radius:6px;padding:.3rem .7rem;
  cursor:pointer;white-space:nowrap;text-decoration:none;display:inline-flex;align-items:center;transition:border-color .15s ease,background-color .15s ease}
.tb-btn:hover{border-color:var(--axis);background:var(--row-hover)}
.path{border:1px solid var(--border);border-radius:14px;background:var(--card);padding:1rem 1.2rem 1.1rem;margin-top:1.4rem}
.path-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:.9rem}
.path-head h4{margin:0;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.path-count{font-size:12.5px;font-weight:700;padding:.2rem .65rem;border-radius:999px;background:var(--warn-bg);color:#9a6a00}
.path-count.all{background:var(--good-bg);color:var(--good-ink)}
.gates{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr))}
.gates li{position:relative;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.15rem;font-size:13px}
.gates li small{color:var(--muted);font-size:12px}
.gates li:not(:last-child)::after{content:"";position:absolute;top:1.15rem;left:calc(50% + 1.3rem);right:calc(-50% + 1.3rem);height:3px;
  border-radius:2px;background:repeating-linear-gradient(90deg,var(--axis) 0 6px,transparent 6px 11px)}
.gates li.g-done.to-done::after{background:var(--good)}
.gates li.g-done.to-pending::after{background:linear-gradient(90deg,var(--good),var(--warning))}
.gates li.g-done.to-fail::after{background:linear-gradient(90deg,var(--good),var(--critical))}
.g-node{width:2.3rem;height:2.3rem;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:14px;text-decoration:none;
  margin-bottom:.35rem;position:relative;z-index:1;transition:transform .15s ease}
.g-node:hover{transform:scale(1.08)}
.g-done .g-node{background:#1d8a4e;color:#fff}
.g-fail .g-node{background:var(--critical);color:#fff}
.g-pending .g-node{background:var(--warn-bg);color:#9a6a00;border:2px solid #c98a00}
.g-notrun .g-node{background:var(--card);color:var(--muted);border:2px solid var(--faint)}
.g-signoff .g-node{background:var(--card);color:var(--muted);border:2px dashed var(--faint);font-size:12px}
@media (max-width:560px){.gates{grid-template-columns:repeat(5,minmax(3.6rem,1fr));overflow-x:auto}.gates li small{display:none}}
.scoredark{background:radial-gradient(120% 90% at 85% 100%,#1d3170 0%,rgba(29,49,112,0) 60%),linear-gradient(160deg,#0f1729,#141d33);
  color:#e8ecf5;border-radius:18px;padding:1.6rem 1.6rem 1.4rem;min-height:100%}
.sd-top{display:flex;gap:1.4rem;align-items:center;flex-wrap:wrap}
.ring{width:9.5rem;height:9.5rem;flex:none}
.ring-track{fill:none;stroke:#2a3352;stroke-width:10}
.ring-arc{fill:none;stroke-width:10;stroke-linecap:round}
.ring-arc.band-good{stroke:#3fbf6f;background:none}.ring-arc.band-warn{stroke:#fab219;background:none}.ring-arc.band-bad{stroke:#ef6b6b;background:none}
.ring-num{font:800 36px ui-sans-serif,system-ui,-apple-system,"Segoe UI",Inter,sans-serif;fill:#fff}
.ring-of{font:500 11px ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;fill:#9aa4bd}
.sd-text{flex:1;min-width:12rem}
.sd-eyebrow{font-size:13px;color:#9aa4bd}
.sd-grade{font:800 1.45rem/1.2 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Inter,sans-serif;margin:.25rem 0 .5rem}
.sd-note{margin:0;color:#aab3c8;font-size:13.5px;line-height:1.5}
.sd-bars{display:grid;gap:.85rem;margin-top:1.5rem}
.sd-row{display:grid;grid-template-columns:7rem minmax(0,1fr) 4.2rem;gap:.9rem;align-items:center;font-size:13.5px}
.sd-track{height:.45rem;border-radius:999px;background:#2a3352;overflow:hidden}
.sd-track b{display:block;height:100%;border-radius:999px}
.sd-security{background:#3987e5}.sd-functional{background:#d95926}.sd-performance{background:#199e70}
.sd-val{text-align:right;color:#c9d0e0;font-variant-numeric:tabular-nums}
.sd-foot{margin:1rem 0 0;font-size:12.5px;color:#9aa4bd}
.sd-link{display:inline-block;margin-top:1.1rem;color:#9fc0ff;font-size:13px;text-decoration:none}
.sd-link:hover{text-decoration:underline}
.ov-summary{margin-top:1.1rem}
.sm-lede{color:var(--muted);font-size:13.5px;margin:.6rem 0 1.2rem;max-width:80ch}
.sm-scale{margin:0 0 1.6rem}
.sm-scale-top{display:flex;justify-content:space-between;gap:1rem;font-size:14px;margin-bottom:.5rem;flex-wrap:wrap}
.sm-scale-top b{font-size:1.25rem}
.sm-bands{position:relative;height:1.7rem}
.sm-band{position:absolute;top:0;bottom:0;background:var(--code-bg);border-right:2px solid var(--card);display:flex;align-items:center;justify-content:center;
  font-size:12px;font-weight:700;color:var(--faint)}
.sm-band:first-child{border-radius:7px 0 0 7px}.sm-band-A{border-right:0;border-radius:0 7px 7px 0}
.sm-band.on{color:var(--ink);background:var(--row-hover);box-shadow:inset 0 -3px 0 var(--ink)}
.sm-mark{position:absolute;top:-.35rem;bottom:-.35rem;width:3px;border-radius:2px;transform:translateX(-50%);background:var(--ink)}
.sm-mark::after{content:attr(data-label);position:absolute;bottom:calc(100% + .2rem);left:50%;transform:translateX(-50%);
  font-size:11.5px;font-weight:700;white-space:nowrap;color:var(--ink)}
.sm-raw{background:none;border-left:2px dashed var(--muted);width:0}
.sm-raw::after{color:var(--muted);font-weight:500;bottom:auto;top:calc(100% + .15rem)}
.sm-ticks{position:relative;height:1.1rem;font-size:11px;color:var(--faint);margin-top:.3rem}
.sm-ticks span{position:absolute;transform:translateX(-50%)}.sm-ticks span:first-child{transform:none}.sm-ticks span:last-child{transform:translateX(-100%)}
.sm-cap{margin:.4rem 0 0;font-size:12.5px;color:var(--muted)}
.sm-group{border-top:1px solid var(--border);padding:.9rem 0 .4rem}
.sm-ghead{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:.55rem}
.sm-gname{display:inline-flex;align-items:center;gap:.5rem;font-weight:700;font-size:14.5px}
.sm-gname .sw{width:.7rem;height:.7rem;border-radius:3px;display:inline-block}
.sm-gpts{font-size:13px;color:var(--muted)}.sm-gpts b{color:var(--ink);font-size:15px}
.sm-row{display:grid;grid-template-columns:minmax(12rem,1fr) minmax(0,1.4fr);gap:.4rem 1.4rem;align-items:center;padding:.45rem 0}
.sm-label b{display:block;font-size:13.5px;font-weight:600}
.sm-label small{display:block;color:var(--muted);font-size:12px;line-height:1.45}
.sm-barcell{display:grid;grid-template-columns:minmax(0,1fr) 9.5rem;align-items:center;gap:.8rem;min-width:0}
.sm-plot{min-width:0}
.sm-track{height:.85rem;background:var(--code-bg);border-radius:5px;overflow:hidden;cursor:help;outline:none;
  box-shadow:inset 0 0 0 1px var(--border)}
.sm-track:hover,.sm-track:focus-visible{box-shadow:inset 0 0 0 1px var(--axis),0 0 0 3px var(--accent-soft)}
.sm-fill{display:block;height:100%;border-radius:5px 0 0 5px}
.sm-notrun .sm-track{background:repeating-linear-gradient(45deg,var(--code-bg) 0 4px,var(--border) 4px 6px)}
.sm-val{font-size:12.5px;white-space:nowrap;color:var(--muted);font-variant-numeric:tabular-nums}
.sm-val b{color:var(--ink)}
.sm-lost{color:var(--muted);margin-left:.15rem}
.sm-foot{font-size:12.5px;color:var(--muted);margin:1rem 0 .4rem}
details.sm-table{margin-top:.6rem}
@media (max-width:760px){.sm-row{grid-template-columns:minmax(0,1fr)}.sm-barcell{grid-template-columns:minmax(0,1fr) 8rem}}
.viztip{position:fixed;z-index:30;background:var(--card);color:var(--ink);border:1px solid var(--border);border-radius:8px;box-shadow:var(--lift);
  padding:.5rem .7rem;font-size:12.5px;pointer-events:none;max-width:22rem}
.viztip b{display:block;margin-bottom:.15rem}.viztip span{display:block;color:var(--muted)}
details{border:1px solid var(--border);border-radius:10px;padding:.6rem .9rem;margin:.6rem 0;background:var(--card);transition:border-color .15s ease}
details:hover{border-color:var(--axis)}
details summary{cursor:pointer;font-weight:600}
.covbar{position:relative;height:1.1rem;background:var(--code-bg);border-radius:4px;margin:.6rem 0 1.6rem;border:1px solid var(--border)}
.covbar .fill{position:absolute;inset:0 auto 0 0;border-radius:3px 0 0 3px}
.covbar .mark{position:absolute;top:-.35rem;bottom:-.35rem;width:2px;background:var(--ink)}
.covbar .mark span{position:absolute;top:1.55rem;transform:translateX(-50%);font-size:11px;color:var(--muted);white-space:nowrap}
.chartcard{border:1px solid var(--border);border-radius:12px;padding:1.1rem 1.2rem;background:var(--card);margin:0 0 1.1rem;position:relative}
.split .chartcard{margin:0}
.chartcard h4{margin:0;font-size:14px}
.chartcard .cap{color:var(--muted);font-size:12.5px;margin:.15rem 0 .5rem}
.legend{display:flex;gap:1rem;flex-wrap:wrap;font-size:12px;color:var(--muted);margin-bottom:.25rem}
.legend span{display:inline-flex;align-items:center;gap:.4rem}
.legend b{display:inline-block;width:14px;height:2px;border-radius:1px}
.legend b.dash{background:none!important;border-top:2px dashed var(--muted);height:0}
.chart svg{display:block;width:100%;height:auto;overflow:visible}
.chart text{fill:var(--faint);font-size:11px;font-family:inherit;font-variant-numeric:tabular-nums}
.tip{position:absolute;pointer-events:none;max-width:min(32rem,92vw);background:var(--card);border:1px solid var(--border);border-radius:6px;padding:.4rem .6rem;font-size:12px;box-shadow:0 4px 14px rgba(0,0,0,.12);display:none;z-index:3;min-width:9rem}
.tip .row{display:flex;align-items:center;gap:.4rem}
.tip .row b{font-weight:700;color:var(--ink)}
.tip .row span{color:var(--muted)}
.tip .key{width:12px;height:2px;border-radius:1px;display:inline-block}
.tip .where{margin-top:.45rem;padding-top:.45rem;border-top:1px solid var(--border);max-width:30rem}
.tip .wh{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.25rem}
.tip .wi{display:grid;grid-template-columns:auto minmax(0,1fr);gap:.15rem .6rem;padding:.12rem 0;align-items:baseline}
.tip .wi code{font-size:11.5px;color:var(--ink);background:var(--code-bg);white-space:nowrap}
.tip .wi span{color:var(--muted);font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tip .wm{color:var(--muted);font-size:11.5px;margin-top:.2rem}
.tip .wf{color:var(--accent);font-size:11px;margin-top:.35rem}
.tip .t{color:var(--muted);margin-bottom:.15rem}
.check-list{list-style:none;padding:0;margin:0}
.check-list li{display:flex;gap:.75rem;align-items:flex-start;padding:.55rem 0;border-bottom:1px solid var(--border)}
.check-list li:last-child{border-bottom:0}
.check-list .lab{flex:1}
.check-list .lab small{display:block;color:var(--muted)}
.check-list input{margin-top:.25rem;width:1rem;height:1rem;accent-color:var(--accent)}
.signoff{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1rem;margin-top:1rem}
.signoff div{border-bottom:1px solid var(--ink);padding:1.6rem 0 .2rem;color:var(--muted);font-size:12px}
.muted{color:var(--muted)}
.empty{color:var(--muted);font-style:italic;padding:.5rem 0}
.masked{font-weight:700;letter-spacing:.03em}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}.tile:hover,.kpi:hover,.chartcard:hover,.chipbar button:hover{transform:none}}
@media print{
  @page{size:A4;margin:12mm}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body{background:#fff;font-size:12px}
  main{padding:0}
  .tabbar,.pager,.filters,.chipbar,button.copy,button.theme,.tb-actions,.viztip,.cmdtip,.tip,.vtip-pop,.sd-link,.tl-detail,.hint,.sm-table{display:none!important}
  .js-tabs section.panel{display:block!important;animation:none!important}
  .tabshell{border:0;padding:0;margin:0;background:none}
  .tabshell section.panel+section.panel{break-before:page}
  .chartcard,.kpi,.tile,.codever,.sumcard,.scoredark,.path,.sm-row,.sm-scale,.tl-row,tr,li{break-inside:avoid}
  .tablewrap{overflow:visible}th{position:static}
  html{zoom:.82}
  table,.tablewrap table{width:100%!important;min-width:0!important}
  td.where,td.issuecol,td.fixcol{min-width:0!important}
  th,td{overflow-wrap:anywhere;padding:.4rem .5rem!important}
  th{overflow-wrap:normal;word-break:normal;white-space:nowrap}
  h2,h3,h4,.sm-ghead,.tl-head{break-after:avoid}
  p.empty,.lede{orphans:2;widows:2}
  .callout,.sm-group,.hero-main,.sd-top{break-inside:avoid}
  table.hist td.cmdcell{min-width:0!important}.jt code,table.hist code.cmd{word-break:break-all}
  .tl-bar[aria-pressed=true]{box-shadow:none!important}
  .tile .go{display:none}
  pre{max-height:none;overflow:visible}
  a{color:inherit;text-decoration:none}
  .tile:hover,.kpi:hover,.chartcard:hover,.card-lift:hover{transform:none!important;box-shadow:none!important}
}
</style>
</head>
<body>
{% set cv = st.code_version or {} %}
{% macro code_version_card(anchor=false) -%}
<div class="codever card-lift"{% if anchor %} id="code-version"{% endif %}>
  <h4>Code checked</h4>
  {% if not cv %}
  <p class="muted">Not recorded: this run was made by a version of secure-vibe-delivery that didn't record the code version.</p>
  {% elif not cv.is_git %}
  <div class="cv-state">{{ status_badge("WARN") }} <span>{{ cv.reason }}. Put the project under git and re-run, so the sign-off names what it covers.</span></div>
  {% else %}
  <dl class="cv-grid">
    <div><dt>Commit</dt><dd>{% if cv.commit %}<code title="{{ cv.commit }}">{{ cv.short }}</code> <button type="button" class="copy" data-copy="{{ cv.commit }}" aria-label="Copy the full commit ID">Copy</button>{% else %}<span class="muted">none yet</span>{% endif %}</dd></div>
    <div><dt>Branch</dt><dd>{% if cv.branch %}<code>{{ cv.branch }}</code>{% elif cv.detached %}detached HEAD{% else %}-{% endif %}</dd></div>
    {% if cv.subject %}<div class="wide"><dt>Message</dt><dd>{{ cv.subject }}</dd></div>{% endif %}
    {% if cv.committed_at %}<div><dt>Committed</dt><dd>{{ cv.committed_at|replace("T", " ") }}</dd></div>{% endif %}
    {% if cv.remote %}<div class="wide"><dt>Repository</dt><dd><code>{{ cv.remote }}</code></dd></div>{% endif %}
    {% if cv.subfolder %}<div class="wide"><dt>Project folder in the repository</dt><dd><code>{{ cv.subfolder }}/</code> <span class="muted">(only changes in this folder count)</span></dd></div>{% endif %}
  </dl>
  {% if cv.changed_during_run %}
  <div class="cv-state">{{ status_badge("FAIL") }} <span><b>The code changed while the checks were running</b>{% if cv.end and cv.end.short and cv.end.short != cv.short %} (commit {{ cv.short }} → {{ cv.end.short }}){% endif %}. The results may mix two versions; re-run before relying on this report.</span></div>
  {% elif cv.dirty %}
  <div class="cv-state">{{ status_badge("WARN") }} <span><b>{{ cv.changed_count }} uncommitted change(s)</b>{% if cv.untracked_count %}, including {{ cv.untracked_count }} new file(s){% endif %}. This report covers the files as they were on disk, which no commit records. Commit and re-run before sign-off.</span></div>
  <details class="cv-files"><summary>Uncommitted files{% if cv.changed_count > cv.changed|length %} (first {{ cv.changed|length }} of {{ cv.changed_count }}){% endif %}</summary>
    <pre>{% for c in cv.changed %}{{ c }}
{% endfor %}</pre></details>
  {% else %}
  <div class="cv-state">{{ status_badge("PASS") }} <span>No uncommitted changes: this report covers exactly commit <code>{{ cv.short }}</code>.</span></div>
  {% endif %}
  {% endif %}
</div>
{%- endmacro %}
{% set VERDICT_TIPS = {
  "GO": "Ready for go-live. Every automated check passed. The Delivery Lead still signs off the manual items on the Go-live checklist.",
  "PROVISIONAL": "Nearly there. Every automated check passed, but performance only ran the 2-minute quick test. Run mode='gate' (15 minutes at 1.5x peak) to turn this into GO.",
  "NO-GO": "Not ready for go-live. At least one must-pass check failed, or didn't run (a skipped check counts as a failure). Start with the Must fix tab."} %}
{% macro vword(v) -%}
<span class="vtip" tabindex="0">{{ v }}<span class="vtip-pop" role="tooltip"><b>{{ v }}</b> {{ VERDICT_TIPS[v] }}<span class="vtip-all">{% for k in ["GO","PROVISIONAL","NO-GO"] if k != v %}<span><b>{{ k }}</b>: {{ VERDICT_TIPS[k].split(".")[0] }}.</span>{% endfor %}</span></span></span>
{%- endmacro %}
{% macro status_badge(s) -%}
{%- set v = s.value if s.value is defined else s -%}
<span class="badge st-{{ v }}"><i>{{ {"PASS":"✓","FAIL":"✕","WARN":"!","NOT_RUN":"⊘"}[v] }}</i>{{ {"PASS":"Pass","FAIL":"Fail","WARN":"Warning","NOT_RUN":"Didn't run"}[v] }}</span>
{%- endmacro %}
{% macro sev(s) %}<span class="sev sev-{{ s }}">{{ s }}</span>{% endmacro %}

{% macro tab(id, label, status=None) -%}
<button type="button" role="tab" id="tab-{{ id }}" aria-controls="{{ id }}" aria-selected="false" tabindex="-1" data-label="{{ label|striptags }}">
{%- if status %}<span class="dot {{ status }}" aria-hidden="true">{{ {"PASS":"✓","FAIL":"✕","WARN":"!","NOT_RUN":"⊘"}[status] }}</span>{% endif %}{{ label }}</button>
{%- endmacro %}
<main><div class="wrap"><div class="tabshell">
<div class="tabbar" role="tablist" aria-label="Report sections">
  {{ tab("verdict", "Overview") }}
  {{ tab("mustfix", "Must fix (" ~ must_fix|length ~ ")") }}
  {{ tab("secrets", "Secrets (" ~ sec.secrets|length ~ ")") }}
  {{ tab("security", "Security", results.security.status.value) }}
  {{ tab("functional", "Functional", results.functional.status.value) }}
  {{ tab("performance", "Performance", results.performance.status.value) }}
  {{ tab("checklist", "Go-live checklist") }}
  {{ tab("logs", "Logs") }}
  {{ tab("history", "History (" ~ history|length ~ ")") }}
  <div class="tb-actions">
    {% if pdf_rel %}<a class="tb-btn" href="{{ pdf_rel }}" download="{{ pdf_rel }}" title="The same report as a PDF file, saved beside this page">⤓ Download PDF</a>{% endif %}
    <button class="tb-btn" id="printBtn" type="button" title="Print, or choose “Save as PDF” in the print dialog">{{ "Print" if pdf_rel else "⤓ Print / Save as PDF" }}</button>
    <button class="theme" id="themeBtn" type="button" aria-label="Switch between light and dark">◐ Theme</button>
  </div>
</div>

<section class="card panel" id="verdict" role="tabpanel" aria-labelledby="tab-verdict">
  {% set H = hero %}
  {% macro band(v) -%}{{ "band-good" if v >= 80 else "band-warn" if v >= 60 else "band-bad" }}{%- endmacro %}
  <div class="hero">
    <div class="hero-main">
      <span class="vpill v-{{ verdict }}"><i aria-hidden="true"></i>{{ vword(verdict) }}</span>
      <h1 class="hero-h">{{ H.head[0] }}<span class="acc acc-{{ H.head[3] }}">{{ H.head[1] }}</span>{{ H.head[2] }}</h1>
      <p class="hero-p">{{ H.text }}</p>
      <div class="hero-meta">
        <span class="br">Project <b>{{ project_name }}</b> <code class="hm-path" title="{{ opts.project_path }}">{{ opts.project_path }}</code></span>
        <span>Run <b><code>{{ st.run_id }}</code></b></span>
        <span>Generated <b>{{ generated }}</b></span>
        <span>Took <b>{{ duration }}</b></span>
        <span>Mode <b>{{ opts.mode }}</b>{% if opts.mode == "quick" %} (indicative){% endif %}</span>
        <span class="br">Peak <b>{{ H.peak }} users</b>{% if H.tested_users %} <span aria-hidden="true">→</span> tested at <b>{{ H.tested_users }}</b>{% endif %}</span>
      </div>
      <div class="path">
        <div class="path-head"><h4>Path to go-live</h4><span class="path-count {{ 'all' if H.cleared >= H.total - 1 and verdict == 'GO' else '' }}">{{ H.cleared }} of {{ H.total }} gates cleared</span></div>
        <ol class="gates">
          {% for g in H.gates %}{% set nxt = H.gates[loop.index] if not loop.last else none %}
          <li class="g-{{ g.state }}{% if nxt %} to-{{ nxt.state }}{% endif %}">
            <a href="#{{ g.tab }}" class="g-node" aria-label="{{ g.label }}: {{ {'done':'cleared','fail':'failed','pending':'still to do','notrun':'didn\'t run','signoff':'manual sign-off'}[g.state] }}, {{ g.sub }}">{{ {"done":"✓","fail":"✕","pending":"!","notrun":"⊘","signoff":"GO"}[g.state] }}</a>
            <b>{{ g.label }}</b><small>{{ g.sub }}</small>
          </li>{% endfor %}
        </ol>
      </div>
    </div>
    <div class="scoredark" role="group" aria-label="Secure-health score">
      <div class="sd-top">
        {% set C = 326.73 %}
        <svg class="ring" viewBox="0 0 120 120" role="img" aria-label="Score {{ score.score }} out of 100">
          <circle cx="60" cy="60" r="52" class="ring-track"/>
          <circle cx="60" cy="60" r="52" class="ring-arc {{ band(score.score) }}" stroke-dasharray="{{ (score.score / 100 * C)|round(2) }} {{ C }}" transform="rotate(-90 60 60)"/>
          <text x="60" y="62" class="ring-num" text-anchor="middle">{{ score.score }}</text>
          <text x="60" y="82" class="ring-of" text-anchor="middle">of 100</text>
        </svg>
        <div class="sd-text">
          <div class="sd-eyebrow">Secure-health score</div>
          <div class="sd-grade">Grade {{ score.grade }} · {{ score.grade_word }}</div>
          <p class="sd-note">{{ H.score_note }}</p>
        </div>
      </div>
      <div class="sd-bars">
        {% for name, label in [("security","Security"),("functional","Functional"),("performance","Performance")] %}{% set c = score.checks[name] %}
        <div class="sd-row"><span>{{ label }}</span>
          <div class="sd-track" role="img" aria-label="{{ label }} {{ c.points }} of {{ c.weight }} points"><b class="sd-{{ name }}" style="width:{{ (c.points / c.weight * 100)|round(1) if c.weight else 0 }}%"></b></div>
          <span class="sd-val">{{ "%.1f"|format(c.points) }}/{{ c.weight }}</span></div>
        {% endfor %}
      </div>
      {% if score.note %}<p class="sd-foot">{{ score.note }}</p>{% endif %}
      <a class="sd-link" href="#scoremath">How the score is worked out <span aria-hidden="true">↓</span></a>
    </div>
  </div>
  {{ code_version_card(true) }}
  <div class="ov-summary">
    <div class="sumcard card-lift">
      <h4>Summary</h4>
      <p class="src">{% if overview.source == "ai" %}Written by your AI assistant from this run's results.{% else %}Automatic summary from the results. For a written one, ask your assistant to "write the summary for this report".{% endif %}</p>
      <p class="overall">{{ overview.overall }}</p>
      <div class="sumcols">
        <div class="ok"><h5><i aria-hidden="true">✓</i>What went well</h5>
          {% if overview.went_well %}<ul>{% for x in overview.went_well %}<li>{{ x }}</li>{% endfor %}</ul>{% else %}<p class="empty">Nothing passed yet.</p>{% endif %}</div>
        <div class="bad"><h5><i aria-hidden="true">✕</i>Where the issues are</h5>
          {% if overview.needs_attention %}<ul>{% for x in overview.needs_attention %}<li>{{ x }}</li>{% endfor %}</ul>{% else %}<p class="empty">No issues found.</p>{% endif %}</div>
        <div class="first"><h5><i aria-hidden="true">→</i>Needs immediate attention</h5>
          {% if overview.fix_first %}<ol>{% for x in overview.fix_first %}<li>{{ x }}</li>{% endfor %}</ol>{% else %}<p class="empty">Nothing urgent.</p>{% endif %}</div>
      </div>
    </div>
  </div>
  {% set all_comps = [] %}{% for name in ["security","functional","performance"] %}{% for comp in score.checks[name].components %}{% set _ = all_comps.append(comp.max_points) %}{% endfor %}{% endfor %}
  {% set scale_max = (all_comps|max) if all_comps else 1 %}
  {% set capped = score.score < score.raw_score %}
  <details class="scoremath" id="scoremath"><summary>How the score is worked out <span class="muted hint">(click to expand the full breakdown)</span></summary>
    <p class="sm-lede">{{ score.method }} Each bar below is one part of the score: its full length is what the part is worth, the coloured
    stretch is what this run earned, and the empty stretch is what it lost.</p>

    <div class="sm-scale" role="img" aria-label="Final score {{ score.score }} of 100, grade {{ score.grade }}{% if capped %}; held down from {{ score.raw_score }} by a cap{% endif %}">
      <div class="sm-scale-top"><span><b>{{ score.score }}</b> / 100 · Grade {{ score.grade }}</span>{% if capped %}<span class="muted">held down from {{ score.raw_score }} by a cap</span>{% endif %}</div>
      <div class="sm-bands">
        {% for g, lo, hi in [("F",0,60),("D",60,70),("C",70,80),("B",80,90),("A",90,100)] %}
        <div class="sm-band sm-band-{{ g }}{{ ' on' if score.grade == g else '' }}" style="left:{{ lo }}%;width:{{ hi - lo }}%"><span>{{ g }}</span></div>
        {% endfor %}
        {% if capped %}<i class="sm-mark sm-raw" style="left:{{ score.raw_score }}%" data-label="{{ score.raw_score }} before cap"></i>{% endif %}
        <i class="sm-mark sm-final" style="left:{{ score.score }}%" data-label="{{ score.score }}"></i>
      </div>
      <div class="sm-ticks">{% for t in [0,60,70,80,90,100] %}<span style="left:{{ t }}%">{{ t }}</span>{% endfor %}</div>
      {% for cap in score.caps %}<p class="sm-cap">Capped: {{ cap }}.</p>{% endfor %}
    </div>

    {% for name, label in [("security","Security"),("functional","Functional"),("performance","Performance")] %}{% set chk = score.checks[name] %}
    <div class="sm-group">
      <div class="sm-ghead"><span class="sm-gname"><i class="sw tl-{{ name }}"></i>{{ label }}</span>
        <span class="sm-gpts"><b>{{ "%.1f"|format(chk.points) }}</b> of {{ chk.weight }} points</span></div>
      {% for comp in chk.components %}{% set lost = (comp.max_points - comp.points)|round(1) %}
      <div class="sm-row{{ ' sm-notrun' if comp.not_run else '' }}">
        <div class="sm-label"><b>{{ comp.label }}</b><small>{{ comp.detail }}</small></div>
        <div class="sm-barcell">
          <div class="sm-plot"><div class="sm-track" style="width:{{ (comp.max_points / scale_max * 100)|round(2) }}%"
               data-viz-tip="{{ label }} · {{ comp.label }}" data-viz-lines="Earned {{ '%g'|format(comp.points) }} of {{ '%g'|format(comp.max_points) }} points|{{ ('Lost ' ~ '%g'|format(lost)) if lost > 0 else 'Nothing lost' }}{% if comp.not_run %}|Didn't run, so it scores 0{% endif %}" tabindex="0">
            <b class="sm-fill tl-{{ name }}" style="width:{{ (comp.points / comp.max_points * 100)|round(2) if comp.max_points else 0 }}%"></b>
          </div></div>
          <span class="sm-val"><b>{{ '%g'|format(comp.points) }}</b> / {{ '%g'|format(comp.max_points) }}{% if comp.not_run %} <span class="sm-lost">didn't run</span>{% elif lost > 0 %} <span class="sm-lost">−{{ '%g'|format(lost) }}</span>{% endif %}</span>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
    <p class="sm-foot">Caps: an exposed secret or a critical issue holds the score at 59 or below; a check that didn't run holds it at 79 or below.
    Grades: A 90+, B 80+, C 70+, D 60+, F below 60.</p>
    <details class="sm-table"><summary>Show as a table</summary>
      <div class="tablewrap"><table><thead><tr><th>Part</th><th class="num">Points</th><th>Why</th></tr></thead><tbody>
        {% for name in ["security","functional","performance"] %}{% for comp in score.checks[name].components %}
        <tr><td>{{ name|title }} · {{ comp.label }}</td><td class="num">{{ comp.points }} / {{ comp.max_points }}</td><td>{{ comp.detail }}</td></tr>
        {% endfor %}{% endfor %}
        <tr><td><b>Total before caps</b></td><td class="num"><b>{{ score.raw_score }} / 100</b></td><td></td></tr>
      </tbody></table></div>
    </details>
  </details>
  <div class="viztip" id="vizTip" role="tooltip" hidden></div>
  <div class="grid3">
    {% for name, label, question in [("security","Security","Is it safe?"),("functional","Functional","Does it work?"),("performance","Performance","Can it cope?")] %}
    {% set r = results[name] %}
    <a class="tile" href="#{{ name }}">
      <h4><span>{{ label }} · {{ question }}</span>{{ status_badge(r.status) }}</h4>
      <p>{{ r.summary or r.reason_not_run }}</p>
      <p class="muted">{{ "Essential: blocks go-live on its own" if name == "security" else "Required: must pass" }}</p>
      <span class="go">Open {{ label }} <span aria-hidden="true">→</span></span>
    </a>
    {% endfor %}
  </div>
  <div class="chartcard" style="margin-top:1.25rem">
    <h4>Security findings by severity</h4>
    <div class="cap">Issues found in our own code and in the libraries we depend on. Hover a segment to see exactly where each issue is; click it to open the Security tab.</div>
    <div class="legend">
      <span><i class="sw" style="background:var(--critical)"></i>critical</span>
      <span><i class="sw" style="background:var(--serious)"></i>high</span>
      <span><i class="sw" style="background:var(--warning)"></i>medium</span>
      <span><i class="sw" style="background:var(--faint)"></i>low</span>
    </div>
    <div class="chart" id="chartSeverity"></div>
    <details><summary>Show as a table</summary>
      <div class="tablewrap"><table><thead><tr><th>Area</th><th class="num">critical</th><th class="num">high</th><th class="num">medium</th><th class="num">low</th></tr></thead><tbody>
        <tr><td>Our code</td>{% for k in ["critical","high","medium","low"] %}<td class="num">{{ sev_counts[k] }}</td>{% endfor %}</tr>
        <tr><td>Libraries</td>{% for k in ["critical","high","medium","low"] %}<td class="num">{{ lib_counts[k] }}</td>{% endfor %}</tr>
        {% if sec.data.get("iac", {}).get("files") %}<tr><td>Infrastructure</td>{% for k in ["critical","high","medium","low"] %}<td class="num">{{ iac_counts[k] }}</td>{% endfor %}</tr>{% endif %}
      </tbody></table></div></details>
  </div>
  <p class="callout">The rule that matters most: <b>a scan that didn't run counts as a failure, never as a pass.</b>
  A security failure is never traded off against functional or performance results.</p>
</section>

<section class="card panel" id="mustfix" role="tabpanel" aria-labelledby="tab-mustfix">
  <h2>What needs fixing, in order</h2>
  <p class="lede">The roadmap's order: leaked keys first, then critical and high issues in our own code, then critical issues in
  libraries, then suspicious packages, failing tests, coverage and performance. After fixing, run everything again.</p>
  {% if must_fix %}
  {% set kinds = must_fix|map(attribute="kind")|unique|list %}
  <div class="chipbar" role="group" aria-label="Filter by type" data-for="mustTable">
    <button type="button" data-kind="" aria-pressed="true">All<span class="n">{{ must_fix|length }}</span></button>
    {% for k in kinds %}<button type="button" data-kind="{{ k }}" aria-pressed="false">{{ k }}<span class="n">{{ must_fix|selectattr("kind","equalto",k)|list|length }}</span></button>{% endfor %}
  </div>
  <div class="filters" data-for="mustTable"><input type="search" placeholder="Search issues, files or fixes" aria-label="Search must-fix items"></div>
  <div class="tablewrap"><table id="mustTable">
    <thead><tr><th class="num">#</th><th>Severity</th><th>Type</th><th>Issue</th><th>How to fix</th></tr></thead>
    <tbody>
    {% for i in must_fix %}
    <tr data-kind="{{ i.kind }}">
      <td class="num">{{ loop.index }}</td><td>{{ sev(i.severity) }}</td><td>{{ i.kind }}</td>
      <td class="issuecol"><b>{{ i.title }}</b>{% if i.where %}<span class="sub where">{{ i.where }}</span>{% endif %}
        {% if i.detail %}<span class="sub">{{ i.detail|truncate(260) }}</span>{% endif %}
        {% if i.sources %}<span class="sub">Reported by {{ i.sources|join(", ") }}</span>{% endif %}</td>
      <td class="fixcol">{{ i.fix or "-" }}{% if i.guide %}<span class="sub">Fixing guide for your assistant: <code>{{ i.guide }}</code></span>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody></table></div>
  {% else %}<p class="empty">Nothing to fix. Every automated check passed.</p>{% endif %}
</section>

<section class="card panel" id="secrets" role="tabpanel" aria-labelledby="tab-secrets">
  <h2>Exposed secrets</h2>
  <p class="lede">Scanned by <b>{{ sec.data.secrets_scanner or "no scanner (didn't run)" }}</b>{% if sec.data.snyk_secrets_unavailable %}.
  Snyk Secrets wasn't available ({{ sec.data.snyk_secrets_unavailable|truncate(160) }}), so the Semgrep fallback ran{% endif %}.
  Values are masked in this report. Snyk Code's hard-coded-secret findings are included.</p>
  {% if sec.secrets %}
  <div class="callout bad"><b>Rotate every key listed here</b>: issue a new one and cancel the old one. Deleting the line isn't enough:
  the old value stays in git history, where anyone with a copy of the repository can read it.</div>
  <div class="tablewrap"><table>
    <thead><tr><th>Type</th><th>Location</th><th>Masked value</th><th>Found by</th></tr></thead>
    <tbody>{% for s in sec.secrets %}
      <tr><td>{{ s.kind }}{% if s.message %}<span class="sub">{{ s.message|truncate(140) }}</span>{% endif %}</td>
      <td class="where">{{ s.file }}:{{ s.line }}</td><td><code class="masked">{{ s.masked_value }}</code></td>
      <td>{{ s.sources|join(", ") }}</td></tr>
    {% endfor %}</tbody></table></div>
  {% elif sec.data.secrets_scanner %}<p class="empty">No secrets found.</p>
  {% else %}<div class="callout bad">The secret scan didn't run, so this check fails.</div>{% endif %}
</section>

<section class="card panel" id="security" role="tabpanel" aria-labelledby="tab-security">
  <h2>Security: is it safe?</h2>
  <p class="lede">Two scanners look at the code from different angles (Snyk Code and Semgrep with the bundled AI-mistake rules);
  Snyk Open Source checks libraries; a provenance check confirms every dependency is real and not brand-new;
  Snyk IaC checks infrastructure files (Terraform, Kubernetes, CloudFormation, Azure ARM) for risky settings when the project has any.</p>
  <div class="kpis">
    <div class="kpi"><div class="v">{{ sev_counts.critical + sev_counts.high }}</div><div class="l">critical + high in our code</div><div class="d muted">{{ sev_counts.medium }} medium · {{ sev_counts.low }} low</div></div>
    <div class="kpi"><div class="v">{{ lib_counts.critical }}</div><div class="l">critical in libraries</div><div class="d muted">{{ lib_counts.high }} high · {{ lib_counts.medium }} medium</div></div>
    <div class="kpi"><div class="v">{{ sec.secrets|length }}</div><div class="l">exposed secrets</div></div>
    <div class="kpi"><div class="v">{{ pkgs|length }}</div><div class="l">suspicious packages</div><div class="d muted">{{ sec.data.get("provenance", {}).get("checked", 0) }} verified</div></div>
    {% if sec.data.get("iac", {}).get("files") %}<div class="kpi"><div class="v">{{ iac_counts.critical + iac_counts.high }}</div><div class="l">critical + high in infrastructure</div><div class="d muted">{{ iac_counts.medium }} medium · {{ iac_counts.low }} low · {{ sec.data.iac.files|length }} file(s)</div></div>{% endif %}
  </div>
  <h3>Scanners</h3>
  <div class="tablewrap"><table><thead><tr><th>Scanner</th><th>Result</th></tr></thead><tbody>
    {% for k, v in sec.data.get("scanners", {}).items() %}<tr><td>{{ k }}</td><td>{{ status_badge("PASS") }} ran · {{ v }}</td></tr>{% endfor %}
    {% if sec.data.secrets_scanner %}<tr><td>secrets</td><td>{{ status_badge("PASS") }} ran · {{ sec.data.secrets_scanner }}</td></tr>{% endif %}
    {% for k, v in sec.data.get("not_run", {}).items() %}<tr><td>{{ k }}</td><td>{{ status_badge("NOT_RUN") }} {{ v }}</td></tr>{% endfor %}
  </tbody></table></div>

  <h3>Issues in our code ({{ code|length }})</h3>
  {% if code %}
  <div class="filters" data-for="codeTable"><input type="search" placeholder="Filter by file, rule or text" aria-label="Filter code issues">
    <select aria-label="Severity"><option value="">All severities</option><option>critical</option><option>high</option><option>medium</option><option>low</option></select></div>
  <div class="tablewrap"><table id="codeTable">
    <thead><tr><th>Severity</th><th>Issue</th><th>Location</th><th>Found by</th></tr></thead><tbody>
    {% for f in code %}<tr data-sev="{{ f.severity }}">
      <td>{{ sev(f.severity) }}</td>
      <td><b>{{ f.title or f.rule_id }}</b><span class="sub">{{ f.message|truncate(300) }}</span>
        {% if f.fix_hint %}<span class="sub"><b>Fix:</b> {{ f.fix_hint|truncate(300) }}</span>{% endif %}
        {% if f.cwe %}<span class="sub">{{ f.cwe|join(", ") }}</span>{% endif %}</td>
      <td class="where">{{ f.file }}:{{ f.line }}</td><td>{{ f.sources|join(", ") }}</td></tr>{% endfor %}
    </tbody></table></div>
  {% else %}<p class="empty">No code issues found{% if "snyk-code" in sec.data.get("not_run", {}) or "semgrep" in sec.data.get("not_run", {}) %} by the scanners that ran{% endif %}.</p>{% endif %}

  <h3>Vulnerable libraries ({{ libs|length }})</h3>
  {% if libs %}
  <div class="filters" data-for="libTable"><input type="search" placeholder="Filter by package or CVE" aria-label="Filter libraries">
    <select aria-label="Severity"><option value="">All severities</option><option>critical</option><option>high</option><option>medium</option><option>low</option></select></div>
  <div class="tablewrap"><table id="libTable">
    <thead><tr><th>Severity</th><th>Package</th><th>Vulnerability</th><th>Fix</th></tr></thead><tbody>
    {% for f in libs %}<tr data-sev="{{ f.severity }}">
      <td>{{ sev(f.severity) }}</td><td><b>{{ f.package }}</b> {{ f.version }}{% if f.message %}<span class="sub">via {{ f.message|truncate(120) }}</span>{% endif %}</td>
      <td>{% if f.url %}<a href="{{ f.url }}" rel="noopener">{{ f.title }}</a>{% else %}{{ f.title }}{% endif %}<span class="sub">{{ f.identifiers|join(", ") }}</span></td>
      <td>{{ f.fix_hint }}</td></tr>{% endfor %}
    </tbody></table></div>
  {% else %}<p class="empty">{{ "Snyk Open Source didn't run." if "snyk-open-source" in sec.data.get("not_run", {}) else "No vulnerable libraries found." }}</p>{% endif %}

  {% set iac_data = sec.data.get("iac", {}) %}
  <h3>Infrastructure settings ({{ iac_issues|length }})</h3>
  {% if not iac_data.get("files") %}
  <p class="empty">No infrastructure files (Terraform, Kubernetes, CloudFormation or Azure ARM) in this project, so Snyk IaC had nothing to check.</p>
  {% elif "snyk-iac" in sec.data.get("not_run", {}) %}
  <p class="empty">Snyk IaC didn't run: {{ sec.data.not_run["snyk-iac"] }}</p>
  {% elif iac_issues %}
  <p class="muted">Checked {{ iac_data.files|length }} file(s): {{ iac_data.get("kinds", [])|join(", ") }}.</p>
  <div class="filters" data-for="iacTable"><input type="search" placeholder="Filter by file, rule or text" aria-label="Filter infrastructure issues">
    <select aria-label="Severity"><option value="">All severities</option><option>critical</option><option>high</option><option>medium</option><option>low</option></select></div>
  <div class="tablewrap"><table id="iacTable">
    <thead><tr><th>Severity</th><th>Issue</th><th>Location</th><th>Fix</th></tr></thead><tbody>
    {% for f in iac_issues %}<tr data-sev="{{ f.severity }}">
      <td>{{ sev(f.severity) }}</td>
      <td>{% if f.url %}<a href="{{ f.url }}" rel="noopener"><b>{{ f.title }}</b></a>{% else %}<b>{{ f.title }}</b>{% endif %}<span class="sub">{{ f.message|truncate(300) }}</span><span class="sub">{{ f.rule_id }}</span></td>
      <td class="where">{{ f.file }}{% if f.line %}:{{ f.line }}{% endif %}</td><td>{{ f.fix_hint|truncate(300) }}</td></tr>{% endfor %}
    </tbody></table></div>
  {% else %}
  <p class="empty">No risky settings found in {{ iac_data.files|length }} infrastructure file(s) ({{ iac_data.get("kinds", [])|join(", ") }}).</p>
  {% endif %}

  <h3>Package provenance ({{ pkgs|length }} flagged)</h3>
  {% if pkgs %}<div class="tablewrap"><table><thead><tr><th>Severity</th><th>Package</th><th>Problem</th><th>Fix</th></tr></thead><tbody>
    {% for f in pkgs %}<tr><td>{{ sev(f.severity) }}</td><td><b>{{ f.package }}</b></td><td>{{ f.message }}</td><td>{{ f.fix_hint }}</td></tr>{% endfor %}
  </tbody></table></div>
  {% else %}<p class="empty">Every direct dependency exists on its public registry and is over 30 days old.</p>{% endif %}
</section>

<section class="card panel" id="functional" role="tabpanel" aria-labelledby="tab-functional">
  <h2>Functional: does it work?</h2>
  {% set c = fun.data.get("counts", {}) %}
  {% if fun.status.value == "NOT_RUN" and not c.get("total") %}
    <div class="callout bad">{{ fun.reason_not_run or fun.summary }}</div>
  {% else %}
  <p class="lede">{{ fun.data.runner }} with coverage. Coverage is the share of code lines a test actually ran; the roadmap's pass mark
  is {{ fun.data.coverage_threshold|int }}%.</p>
  <div class="kpis">
    <div class="kpi"><div class="v">{{ c.get("passed", 0) }}/{{ c.get("total", 0) }}</div><div class="l">tests passed</div></div>
    <div class="kpi"><div class="v">{{ c.get("failed", 0) + c.get("errors", 0) }}</div><div class="l">failed or errored</div></div>
    <div class="kpi"><div class="v">{{ c.get("skipped", 0) }}</div><div class="l">skipped</div></div>
    <div class="kpi"><div class="v">{{ "%.1f"|format(fun.data.coverage_pct) ~ "%" if fun.data.coverage_pct is not none else "-" }}</div><div class="l">line coverage</div></div>
  </div>
  {% if fun.data.coverage_pct is not none %}
  {% set cov = fun.data.coverage_pct %}
  <div class="covbar" role="img" aria-label="Coverage {{ cov }} percent against a {{ fun.data.coverage_threshold|int }} percent target">
    <div class="fill" style="width:{{ [cov,100]|min }}%;background:{{ 'var(--good)' if cov >= fun.data.coverage_threshold else 'var(--critical)' }}"></div>
    <div class="mark" style="left:{{ fun.data.coverage_threshold }}%"><span>target {{ fun.data.coverage_threshold|int }}%</span></div>
  </div>
  {% elif fun.data.coverage_note %}<div class="callout warn">{{ fun.data.coverage_note }}</div>{% endif %}
  {% if fun.reason_not_run %}<div class="callout bad">{{ fun.reason_not_run|truncate(600) }}</div>{% endif %}
  {% endif %}
  {% if fun.findings %}
  <h3>Failing tests ({{ fun.findings|length }})</h3>
  {% for f in fun.findings %}
  <details><summary>{{ f.title }} <span class="muted">{{ f.file }}{% if f.line %}:{{ f.line }}{% endif %}</span></summary><pre>{{ f.message }}</pre></details>
  {% endfor %}
  <p class="muted">AI-written tests often check what the code <i>does</i>, not what it was meant to do. Check each failure against the original request.</p>
  {% endif %}
  {% if fun.data.get("coverage_files") %}
  {% if fun.data.coverage_files|length > 1 %}
  <div class="chartcard">
    <h4>Least-covered files</h4>
    <div class="cap">Share of each file's lines that the tests ran, lowest first. The line marks the {{ fun.data.coverage_threshold|int }}% target.</div>
    <div class="chart" id="chartCoverage"></div>
  </div>
  {% endif %}
  <details><summary>Least-covered files as a table</summary>
  <div class="tablewrap"><table><thead><tr><th>File</th><th class="num">Coverage</th><th class="num">Uncovered lines</th></tr></thead><tbody>
    {% for f in fun.data.coverage_files[:20] %}<tr><td class="where">{{ f.file }}</td><td class="num">{{ f.pct }}%</td><td class="num">{{ f.missing }}</td></tr>{% endfor %}
  </tbody></table></div></details>
  {% endif %}
  <h3>Wrong-case tests</h3>
  {% if fun.data.get("wrong_case_test_files") %}
  <p>Found tests that look for refused requests in: {% for f in fun.data.wrong_case_test_files[:8] %}<code>{{ f }}</code>{{ ", " if not loop.last }}{% endfor %}.
  Check that they cover all three cases.</p>
  {% else %}
  <div class="callout warn">No tests found for requests that should fail. For every page and API, add tests where a logged-out visitor is refused,
  user A asking for user B's data gets nothing, and a basic user is turned away from admin actions. These also prove the security rule
  that users only see their own data.</div>
  {% endif %}
</section>

<section class="card panel" id="performance" role="tabpanel" aria-labelledby="tab-performance">
  <h2>Performance: can it cope?</h2>
  {% set a = perf.data.get("aggregate") %}
  {% if not a %}
    <div class="callout bad">{{ perf.reason_not_run or perf.summary }}</div>
    <p class="muted">Run again with <code>target_url</code> set to the test environment (never production), for example
    <code>svd_run(project_path=..., target_url="http://127.0.0.1:8000")</code>.</p>
  {% else %}
  <p class="lede">Locust played <b>{{ perf.data.users }}</b> users (1.5 × the expected peak of {{ perf.data.peak_users }}), adding
  {{ perf.data.spawn_rate }} a second, for <b>{{ perf.data.duration }}</b> against <code>{{ perf.data.target_url }}</code>.
  Locustfile: {{ perf.data.locustfile_source }}.
  {% if native_rel %}<a href="{{ native_rel }}">Open Locust's own report</a>.{% endif %}</p>
  {% if opts.mode != "gate" %}<div class="callout warn">Quick mode: these numbers are indicative. The go-live run holds 1.5× peak for 15 minutes
  (<code>mode="gate"</code>).</div>{% endif %}
  <div class="kpis">
    <div class="kpi"><div class="v">{{ "{:,}".format(a.requests) }}</div><div class="l">requests</div></div>
    <div class="kpi"><div class="v">{{ "%.1f"|format(a.rps) }}</div><div class="l">requests / second</div></div>
    <div class="kpi"><div class="v">{{ a.failure_pct }}%</div><div class="l">failed</div><div class="d">{{ status_badge("PASS" if a.failure_pct < 1 else "FAIL") }} target &lt; 1%</div></div>
    <div class="kpi"><div class="v">{{ a.p50|int }} ms</div><div class="l">median (p50)</div></div>
    <div class="kpi"><div class="v">{{ a.p95|int }} ms</div><div class="l">p95</div><div class="d">{{ status_badge("PASS" if a.p95 <= perf.data.p95_target_ms else "FAIL") }} target ≤ {{ perf.data.p95_target_ms }} ms</div></div>
    <div class="kpi"><div class="v">{{ a.p99|int }} ms</div><div class="l">p99</div><div class="d muted">max {{ a.max|int }} ms</div></div>
  </div>
  <div class="split">
  <div class="chartcard"><h4>Response time</h4><div class="cap">Milliseconds, all requests. Dashed line is the agreed p95 target.</div>
    <div class="legend"><span><b style="background:var(--series-1)"></b>p50 (median)</span><span><b style="background:var(--series-2)"></b>p95</span><span><b class="dash"></b>p95 target</span></div>
    <div class="chart" id="chartLatency"></div></div>
  <div class="chartcard"><h4>Throughput</h4><div class="cap">Requests per second, all requests.</div>
    <div class="legend"><span><b style="background:var(--series-1)"></b>requests/s</span><span><b style="background:var(--series-2)"></b>failures/s</span></div>
    <div class="chart" id="chartRps"></div></div>
  <div class="chartcard"><h4>Simulated users</h4><div class="cap">Users running at each moment: the ramp, then the hold.</div>
    <div class="chart" id="chartUsers"></div></div>
  {% if perf.data.endpoints|length > 1 %}<div class="chartcard"><h4>p95 response time by endpoint</h4><div class="cap">Milliseconds. The line marks the {{ perf.data.p95_target_ms }} ms target; the table below has every value.</div>
    <div class="chart" id="chartEndpoints"></div></div>{% endif %}
  </div>

  <h3>Per endpoint</h3>
  <div class="tablewrap"><table>
    <thead><tr><th>Endpoint</th><th class="num">Requests</th><th class="num">Failed</th><th class="num">req/s</th><th class="num">p50</th><th class="num">p95</th><th class="num">p99</th><th class="num">max</th></tr></thead><tbody>
    {% for e in perf.data.endpoints %}<tr><td><b>{{ e.type }}</b> {{ e.name }}</td><td class="num">{{ "{:,}".format(e.requests) }}</td>
      <td class="num">{% if e.failure_pct >= 1 %}<span class="sev sev-critical">{{ e.failure_pct }}%</span>{% else %}{{ e.failure_pct }}%{% endif %}</td>
      <td class="num">{{ "%.1f"|format(e.rps) }}</td><td class="num">{{ e.p50|int }}</td>
      <td class="num">{% if e.p95 > perf.data.p95_target_ms %}<span class="sev sev-high">{{ e.p95|int }}</span>{% else %}{{ e.p95|int }}{% endif %}</td>
      <td class="num">{{ e.p99|int }}</td><td class="num">{{ e.max|int }}</td></tr>{% endfor %}
    <tr><td><b>All requests</b></td><td class="num"><b>{{ "{:,}".format(a.requests) }}</b></td><td class="num"><b>{{ a.failure_pct }}%</b></td><td class="num"><b>{{ "%.1f"|format(a.rps) }}</b></td><td class="num"><b>{{ a.p50|int }}</b></td><td class="num"><b>{{ a.p95|int }}</b></td><td class="num"><b>{{ a.p99|int }}</b></td><td class="num"><b>{{ a.max|int }}</b></td></tr>
  </tbody></table></div>
  {% if perf.data.failures %}
  <h3>Failures</h3>
  <div class="tablewrap"><table><thead><tr><th>Request</th><th>Error</th><th class="num">Count</th></tr></thead><tbody>
    {% for f in perf.data.failures %}<tr><td><b>{{ f.method }}</b> {{ f.name }}</td><td>{{ f.error|truncate(300) }}</td><td class="num">{{ f.count }}</td></tr>{% endfor %}
  </tbody></table></div>{% endif %}
  {% if perf.data.exceptions %}
  <h3>Exceptions in the locustfile</h3>
  {% for e in perf.data.exceptions %}<details><summary>{{ e.count }} × {{ e.message|truncate(140) }}</summary><pre>{{ e.traceback }}</pre></details>{% endfor %}
  {% endif %}
  <details><summary>Time-series data table</summary>
  <div class="tablewrap" style="max-height:20rem;overflow:auto"><table><thead><tr><th class="num">t (s)</th><th class="num">users</th><th class="num">req/s</th><th class="num">fail/s</th><th class="num">p50</th><th class="num">p95</th></tr></thead><tbody>
    {% for s in perf.data.series %}<tr><td class="num">{{ s.t }}</td><td class="num">{{ s.users }}</td><td class="num">{{ s.rps }}</td><td class="num">{{ s.fps }}</td><td class="num">{{ s.p50|int if s.p50 is not none else "-" }}</td><td class="num">{{ s.p95|int if s.p95 is not none else "-" }}</td></tr>{% endfor %}
  </tbody></table></div></details>
  {% endif %}
  <p class="muted">If the app calls an AI model, a load test is also a cost test: check usage limits and spend for this run.</p>
</section>

<section class="card panel" id="checklist" role="tabpanel" aria-labelledby="tab-checklist">
  <h2>The go-live checklist</h2>
  <p class="lede">Signed by the Delivery Lead before every release. Every box must be ticked, or covered by an approved exception
  (a written reason, a named owner, an end date at most 90 days away, and the Delivery Lead's approval).</p>
  <h3>Code version this sign-off covers</h3>
  {{ code_version_card() }}
  {% for name, r in checklist %}
  <h3>{{ name|title }} {{ "(must pass)" if name == "security" else "" }}</h3>
  <ul class="check-list">
    {% for s in r.subchecks %}
    <li>{% if s.id in ["own-data","review"] %}<input type="checkbox" aria-label="Attest: {{ s.label }}">{% else %}{{ status_badge(s.status) }}{% endif %}
      <div class="lab">{{ s.label }}<small>{{ s.detail|truncate(300) }}</small></div></li>
    {% endfor %}
  </ul>
  {% endfor %}
  <div class="signoff"><div>Delivery Lead</div><div>Date</div><div>Exceptions approved (IDs)</div>{% if cv.commit %}<div>Commit {{ cv.short }}</div>{% endif %}</div>
</section>

<section class="card panel" id="logs" role="tabpanel" aria-labelledby="tab-logs">
  {% set CHECK_NAMES = {"security": "Security", "functional": "Functional", "performance": "Performance", "setup": "Setup"} %}
  <div class="tl-head">
    <div><h2>What ran, and for how long</h2>
    <p class="lede">{% if timeline.rows %}{{ timeline.total_text|capitalize }} end to end. Select a bar to see the exact command and copy it.{% else %}No steps were recorded for this run.{% endif %}</p></div>
    {% if timeline.rows %}<ul class="tl-legend" aria-label="Colour key">
      {% for c in ["security","functional","performance","setup"] if c in timeline.checks %}<li><i class="sw tl-{{ c }}"></i>{{ CHECK_NAMES[c] }}</li>{% endfor %}
      {% if timeline.any_skipped %}<li><i class="sw tl-skipped"></i>Skipped</li>{% endif %}
    </ul>{% endif %}
  </div>
  {% if timeline.rows %}
  <div class="tl" id="timeline">
    {% for r in timeline.rows %}
    {% set outside_left = (r.left + r.width) > 88 and not r.label_inside %}
    <div class="tl-row">
      <div class="tl-label">{{ r.label }}</div>
      <div class="tl-track">
        <button type="button" class="tl-bar tl-{{ 'skipped' if r.skipped else r.check }}" data-row="{{ loop.index0 }}"
          style="left:{{ r.left }}%;width:{{ r.width }}%" aria-pressed="{{ 'true' if loop.first else 'false' }}"
          aria-label="{{ r.label }}: starts at {{ r.start_text }}, {{ r.dur_text }}{{ ', skipped' if r.skipped else '' }}">{% if r.label_inside %}<span class="tl-dur in">{{ r.dur_text }}{{ " · skipped" if r.skipped else "" }}</span>{% endif %}</button>
        {% if not r.label_inside %}<span class="tl-dur {{ 'before' if outside_left else 'after' }}" style="{{ ('right:' ~ (100 - r.left)|round(3) ~ '%') if outside_left else ('left:' ~ (r.left + r.width)|round(3) ~ '%') }}" aria-hidden="true">{{ r.dur_text }}{{ " · skipped" if r.skipped else "" }}</span>{% endif %}
      </div>
    </div>
    {% endfor %}
    <div class="tl-row tl-axisrow" aria-hidden="true"><div></div><div class="tl-axis">
      {% for t in timeline.ticks %}<span class="{{ 'end' if t.end else ('start' if loop.first else '') }}" style="left:{{ t.pct }}%">{{ t.label }}</span>{% endfor %}
    </div></div>
  </div>
  {% for r in timeline.rows %}
  <div class="tl-detail" data-row="{{ loop.index0 }}" {% if not loop.first %}hidden{% endif %} aria-live="polite">
    <div class="tl-dtitle"><b>{{ r.label }}</b> <span class="muted">· starts at {{ r.start_text }} · {{ r.dur_text }}{% if r.exit_text %} · {{ r.exit_text }}{% endif %}{% if r.skipped %} · skipped{% endif %}</span></div>
    {% if r.note %}<p class="tl-what">{{ r.note }}. Only package names are sent to the public registries; no command to copy.</p>{% endif %}
    {% if r.skipped %}<p class="tl-what"><b>Skipped:</b> this step ran but didn't produce results. {{ r.why }}</p>{% endif %}
    {% for c in r.commands %}
    <div class="tl-cmd">
      <p class="tl-what">{{ c.what }} {{ c.exit_text }}</p>
      <div class="tl-cmdline"><code>{{ c.text }}</code><button type="button" class="copy" data-copy="{{ c.text }}" aria-label="Copy this command">Copy</button></div>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  {% endif %}

  <h3>Every step, in order ({{ journal|length }} entries)</h3>
  <p class="muted">The full log, including the decisions taken along the way. Download it as a <a href="{{ runlog_rel }}">text file</a>.</p>
  <div class="filters" data-for="journalTable"><input type="search" placeholder="Search the log: a command, a tool, a file" aria-label="Search the run log"></div>
  <div class="tablewrap"><table class="jt" id="journalTable"><thead><tr><th class="num">#</th><th>Time</th><th>Type</th><th>What happened</th><th class="num">Exit</th><th class="num">Took</th></tr></thead><tbody>
    {% for e in journal %}<tr>
      <td class="num">{{ loop.index }}</td><td class="k">{{ hms(e.t) }}</td><td class="k"><span class="kind">{{ e.kind }}</span></td>
      <td>{% if e.kind == "command" %}<code>{{ e.text }}</code><span class="sub">in {{ e.cwd }}{% if e.timed_out %} · timed out{% endif %}{% if e.error %} · {{ e.error }}{% endif %}</span>{% else %}{{ e.text }}{% endif %}</td>
      <td class="num">{{ e.exit_code if e.kind == "command" and e.exit_code is not none else ("-" if e.kind == "command" else "") }}</td>
      <td class="num">{{ (e.duration_s ~ "s") if e.kind == "command" else "" }}</td></tr>{% endfor %}
  </tbody></table></div>
  <h3>Tool versions</h3>
  <p>{% for k, v in st.tool_versions.items() %}<code>{{ k }} {{ v }}</code> {% endfor %}<code>secure-vibe-delivery {{ server_version }}</code></p>
  <h3>Settings</h3>
  <p class="muted">peak users {{ opts.peak_users }} · p95 target {{ opts.response_time_p95_ms }} ms · coverage target {{ opts.coverage_threshold|int }}% ·
  checks {{ opts.checks|join(", ") }} · mode {{ opts.mode }}</p>
  <p class="muted">Raw tool output: <code>{{ opts.project_path }}/.svd/runs/{{ st.run_id }}/raw/</code>. Secret-scanner output is stored masked.
  Generated by secure-vibe-delivery, following the Secure Vibe Delivery roadmap (T-Labs Buy, Oct 2026).</p>
</section>

<section class="card panel" id="history" role="tabpanel" aria-labelledby="tab-history">
  <h2>History: every command, in order</h2>
  <p class="lede">The exact commands this run executed, oldest first. Hover over or tab to a command to see what it
  checks; press <b>Copy</b> to put it on your clipboard and run it yourself from the project folder.</p>
  {% if history %}
  <div class="filters" data-for="historyTable"><input type="search" placeholder="Search commands: snyk, semgrep, pytest, locust" aria-label="Search the command history"></div>
  <div class="tablewrap"><table class="hist" id="historyTable"><thead><tr><th class="num">#</th><th>Time</th><th>Tool</th><th>Command</th><th class="num">Exit</th><th class="num">Took</th><th><span class="sr">Copy</span></th></tr></thead><tbody>
    {% for h in history %}<tr>
      <td class="num">{{ loop.index }}</td><td class="k">{{ hms(h.t) }}</td><td class="k"><span class="tool">{{ h.tool }}</span></td>
      <td class="cmdcell"><code class="cmd" tabindex="0" data-tip-title="{{ h.title }}" data-tip-what="{{ h.what }}" data-tip-cwd="{{ h.cwd }}">{{ h.text }}</code>
        <span class="sub">{{ h.title }}{% if h.timed_out %} · timed out{% endif %}{% if h.error %} · {{ h.error }}{% endif %}</span></td>
      <td class="num">{{ h.exit_code if h.exit_code is not none else "-" }}</td>
      <td class="num">{{ h.duration_s }}s</td>
      <td><button type="button" class="copy" data-copy="{{ h.text }}" aria-label="Copy command {{ loop.index }}">Copy</button></td></tr>{% endfor %}
  </tbody></table></div>
  <div class="cmdtip" id="cmdTip" role="tooltip" hidden><b class="t"></b><span class="w"></span><span class="c"></span></div>
  {% else %}
  <p class="muted">No commands were recorded for this run.</p>
  {% endif %}
</section>

</div></div></main>

<script type="application/json" id="reportData">{{ report_json }}</script>
<script>
(function(){
  // Theme toggle: light ↔ dark, remembered per viewer when storage is available.
  var root=document.documentElement, KEY="svd-theme";
  try{var saved=localStorage.getItem(KEY); if(saved) root.setAttribute("data-theme",saved);}catch(e){}
  document.getElementById("themeBtn").addEventListener("click",function(){
    var cur=root.getAttribute("data-theme")||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");
    var next=cur==="dark"?"light":"dark"; root.setAttribute("data-theme",next);
    try{localStorage.setItem(KEY,next);}catch(e){}
  });


  // History: copy buttons and the "what does this command do" pop-up.
  function copyText(text,btn){
    function done(){btn.textContent="Copied";btn.classList.add("done");setTimeout(function(){btn.textContent="Copy";btn.classList.remove("done");},1500);}
    function fallback(){var ta=document.createElement("textarea");ta.value=text;ta.setAttribute("readonly","");ta.style.position="fixed";ta.style.opacity="0";
      document.body.appendChild(ta);ta.select();try{document.execCommand("copy");done();}catch(e){btn.textContent="Press Ctrl+C";}document.body.removeChild(ta);}
    if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text).then(done,fallback);}else{fallback();}
  }
  [].forEach.call(document.querySelectorAll("button.copy"),function(b){b.addEventListener("click",function(){copyText(b.getAttribute("data-copy"),b);});});
  var ctip=document.getElementById("cmdTip");
  if(ctip){
    // The tab panel animates transform, which would make it the reference box for a fixed-position child;
    // living directly under <body> keeps the pop-up positioned against the window.
    document.body.appendChild(ctip);
    function showTip(c){
      ctip.querySelector(".t").textContent=c.getAttribute("data-tip-title");
      ctip.querySelector(".w").textContent=c.getAttribute("data-tip-what");
      ctip.querySelector(".c").textContent="Runs in: "+c.getAttribute("data-tip-cwd");
      ctip.hidden=false;
      var r=c.getBoundingClientRect(), tw=ctip.offsetWidth, th=ctip.offsetHeight;
      // Beside the command, on its right; if the command runs too close to the edge, pin to the right of the screen.
      var left=r.right+12; if(left+tw>window.innerWidth-12) left=Math.max(12,window.innerWidth-tw-12);
      var top=Math.max(8,Math.min(r.top-4,window.innerHeight-th-8));
      ctip.style.left=left+"px"; ctip.style.top=top+"px";
    }
    function hideTip(){ctip.hidden=true;}
    [].forEach.call(document.querySelectorAll("code.cmd"),function(c){
      c.addEventListener("mouseenter",function(){showTip(c);}); c.addEventListener("mouseleave",hideTip);
      c.addEventListener("focus",function(){showTip(c);}); c.addEventListener("blur",hideTip);
    });
    window.addEventListener("scroll",hideTip,true);
    document.addEventListener("keydown",function(e){if(e.key==="Escape")hideTip();});
  }


  // Logs timeline: select a bar to show its command; arrow keys move between bars.
  var tlBars=[].slice.call(document.querySelectorAll(".tl-bar"));
  var tlDetails=[].slice.call(document.querySelectorAll(".tl-detail"));
  function tlSelect(i,focus){
    tlBars.forEach(function(b,j){b.setAttribute("aria-pressed",j===i?"true":"false");});
    tlDetails.forEach(function(d){d.hidden=d.getAttribute("data-row")!==String(i);});
    if(focus) tlBars[i].focus();
  }
  tlBars.forEach(function(b,i){
    b.addEventListener("click",function(){tlSelect(i);});
    b.addEventListener("keydown",function(e){
      if(e.key==="ArrowDown"||e.key==="ArrowRight"){e.preventDefault();tlSelect(Math.min(i+1,tlBars.length-1),true);}
      if(e.key==="ArrowUp"||e.key==="ArrowLeft"){e.preventDefault();tlSelect(Math.max(i-1,0),true);}
    });
  });


  // Score breakdown bars: hover or focus shows the exact points.
  var vtipEl=document.getElementById("vizTip");
  if(vtipEl){
    document.body.appendChild(vtipEl);
    function vShow(t){
      vtipEl.innerHTML=""; var b=document.createElement("b"); b.textContent=t.getAttribute("data-viz-tip"); vtipEl.appendChild(b);
      (t.getAttribute("data-viz-lines")||"").split("|").forEach(function(l){if(!l)return; var s=document.createElement("span"); s.textContent=l; vtipEl.appendChild(s);});
      vtipEl.hidden=false; var r=t.getBoundingClientRect();
      var left=Math.min(Math.max(8,r.left),window.innerWidth-vtipEl.offsetWidth-8), top=r.bottom+8;
      if(top+vtipEl.offsetHeight>window.innerHeight-8) top=r.top-vtipEl.offsetHeight-8;
      vtipEl.style.left=left+"px"; vtipEl.style.top=top+"px";
    }
    function vHide(){vtipEl.hidden=true;}
    [].forEach.call(document.querySelectorAll("[data-viz-tip]"),function(t){
      t.addEventListener("mouseenter",function(){vShow(t);}); t.addEventListener("mouseleave",vHide);
      t.addEventListener("focus",function(){vShow(t);}); t.addEventListener("blur",vHide);});
    window.addEventListener("scroll",vHide,true);
  }


  // PDF / printing: every tab one after another, light colours, every section unfolded.
  var printState=null;
  function preparePrint(){
    if(printState) return;
    printState={theme:root.getAttribute("data-theme"),title:document.title,closed:[]};
    root.setAttribute("data-theme","light");
    [].forEach.call(document.querySelectorAll("details:not([open])"),function(d){if(!d.classList.contains("sm-table")){printState.closed.push(d);d.open=true;}});
    document.title={{ ("svd-report-" ~ project_name ~ "-" ~ st.run_id)|tojson }};
    if(typeof redraws!=="undefined") redraws.forEach(function(f){f();});
  }
  function restorePrint(){
    if(!printState) return;
    if(printState.theme) root.setAttribute("data-theme",printState.theme); else root.removeAttribute("data-theme");
    printState.closed.forEach(function(d){d.open=false;});
    document.title=printState.title; printState=null;
  }
  window.addEventListener("beforeprint",preparePrint);
  window.addEventListener("afterprint",restorePrint);
  var printBtn=document.getElementById("printBtn");
  if(printBtn) printBtn.addEventListener("click",function(){preparePrint(); setTimeout(function(){window.print();},50);});
  if(/[?&]print=1/.test(location.search)){preparePrint(); root.classList.add("printing");}

  // Tabs: one section at a time, synced with the URL hash, with Previous/Next links.
  var tabs=[].slice.call(document.querySelectorAll('[role=tab]'));
  var panels=tabs.map(function(t){return document.getElementById(t.getAttribute("aria-controls"));});
  var redraws=[]; window.__svdRedraw=function(f){redraws.push(f);};
  root.classList.add("js-tabs");
  panels.forEach(function(p,i){
    var nav=document.createElement("nav"); nav.className="pager"; nav.setAttribute("aria-label","Section navigation");
    function link(j,cls,text){var a=document.createElement("a"); a.href="#"+panels[j].id; a.className=cls;
      var arr=document.createElement("span"); arr.className="arr"; arr.setAttribute("aria-hidden","true"); arr.textContent=cls==="prev"?"←":"→";
      var t=document.createElement("span"); t.className="txt"; t.textContent=text;
      if(cls==="prev"){a.appendChild(arr); a.appendChild(document.createTextNode(" ")); a.appendChild(t);} else {a.appendChild(t); a.appendChild(document.createTextNode(" ")); a.appendChild(arr);}
      a.addEventListener("click",function(e){e.preventDefault(); show(j,true); window.scrollTo({top:document.querySelector(".tabshell").offsetTop-8,behavior:"smooth"});}); nav.appendChild(a);}
    if(i>0) link(i-1,"prev","Previous: "+tabs[i-1].dataset.label);
    if(i<panels.length-1) link(i+1,"next","Next: "+tabs[i+1].dataset.label);
    p.appendChild(nav);
  });
  function show(i,push){
    tabs.forEach(function(t,j){var on=j===i; t.setAttribute("aria-selected",on); t.tabIndex=on?0:-1; panels[j].classList.toggle("active",on);});
    tabs[i].scrollIntoView({block:"nearest",inline:"nearest"});
    if(push) history.replaceState(null,"","#"+panels[i].id);
    redraws.forEach(function(f){f();});
  }
  tabs.forEach(function(t,i){
    t.addEventListener("click",function(){show(i,true);});
    t.addEventListener("keydown",function(e){var k=e.key,n=null;
      if(k==="ArrowRight")n=(i+1)%tabs.length; else if(k==="ArrowLeft")n=(i-1+tabs.length)%tabs.length;
      else if(k==="Home")n=0; else if(k==="End")n=tabs.length-1;
      if(n!==null){e.preventDefault(); show(n,true); tabs[n].focus();}});
  });
  function fromHash(){var id=location.hash.slice(1),i=panels.findIndex(function(p){return p.id===id;});
    if(i<0&&id){var target=document.getElementById(id), pi=target?panels.findIndex(function(p){return p.contains(target);}):-1;
      if(pi>=0){show(pi,false); if(target.tagName==="DETAILS") target.open=true;
        setTimeout(function(){target.scrollIntoView({behavior:"smooth",block:"start"});},60); return true;}}
    show(i<0?0:i,false); return false;}
  window.addEventListener("hashchange",function(){if(!fromHash()) window.scrollTo({top:document.querySelector(".tabshell").offsetTop-8,behavior:"smooth"});}); fromHash();

  // Table filters: free-text search, severity select and type chips combine per table.
  var tableState={};
  function applyFilter(id){
    var table=document.getElementById(id), st=tableState[id]; if(!table||!st) return;
    table.querySelectorAll("tbody tr").forEach(function(tr){
      var ok=(!st.q||tr.textContent.toLowerCase().indexOf(st.q)>=0)&&(!st.sev||tr.dataset.sev===st.sev)&&(!st.kind||tr.dataset.kind===st.kind);
      tr.style.display=ok?"":"none";
    });
  }
  function state(id){return tableState[id]||(tableState[id]={q:"",sev:"",kind:""});}
  document.querySelectorAll(".filters").forEach(function(f){
    var id=f.dataset.for, input=f.querySelector("input"), sel=f.querySelector("select");
    if(input) input.addEventListener("input",function(){state(id).q=input.value.toLowerCase(); applyFilter(id);});
    if(sel) sel.addEventListener("change",function(){state(id).sev=sel.value; applyFilter(id);});
  });
  document.querySelectorAll(".chipbar").forEach(function(bar){
    var id=bar.dataset.for, btns=[].slice.call(bar.querySelectorAll("button"));
    btns.forEach(function(b){b.addEventListener("click",function(){
      btns.forEach(function(x){x.setAttribute("aria-pressed",x===b);});
      state(id).kind=b.dataset.kind; applyFilter(id);
    });});
  });

  // Charts
  var data=JSON.parse(document.getElementById("reportData").textContent||"{}");
  var series=data.series||[];
  var NS="http://www.w3.org/2000/svg";
  function el(tag,attrs,parent){var e=document.createElementNS(NS,tag);for(var k in attrs)e.setAttribute(k,attrs[k]);if(parent)parent.appendChild(e);return e;}
  function niceMax(v){if(v<=0)return 1;var p=Math.pow(10,Math.floor(Math.log10(v)));var n=v/p;
    var steps=[1,1.2,1.6,2,4,6,8,10]; for(var i=0;i<steps.length;i++){if(n<=steps[i]) return steps[i]*p;} return 10*p;}
  function fmtT(s){var m=Math.floor(s/60),r=s%60;return m?m+"m"+(r?(r<10?"0":"")+r+"s":""):r+"s";}
  function fmtV(v,unit){if(v==null)return "-";return (unit==="ms"?Math.round(v).toLocaleString():(Math.round(v*10)/10).toLocaleString())+(unit?" "+unit:"");}

  function lineChart(host,cfg){
    var card=host.parentElement;
    var tip=document.createElement("div"); tip.className="tip"; card.appendChild(tip);
    function draw(){
      host.innerHTML="";
      var W=Math.max(300,host.clientWidth), H=Math.round(Math.min(240,Math.max(170,W*0.28)));
      var m={l:52,r:16,t:10,b:26}, iw=W-m.l-m.r, ih=H-m.t-m.b;
      var svg=el("svg",{viewBox:"0 0 "+W+" "+H,role:"img","aria-label":cfg.label},host);
      var xs=series.map(function(d){return d.t}), xmax=Math.max(1,xs[xs.length-1]);
      var vals=[]; cfg.lines.forEach(function(l){series.forEach(function(d){if(d[l.key]!=null)vals.push(d[l.key]);});});
      if(cfg.ref!=null) vals.push(cfg.ref*1.08);
      var ymax=niceMax(Math.max.apply(null,vals.concat([0]))*1.05);
      function X(t){return m.l+iw*t/xmax} function Y(v){return m.t+ih-ih*v/ymax}
      for(var i=0;i<=4;i++){var v=ymax*i/4,y=Y(v);
        el("line",{x1:m.l,x2:W-m.r,y1:y,y2:y,stroke:i===0?"var(--axis)":"var(--grid)","stroke-width":1},svg);
        var tx=el("text",{x:m.l-8,y:y+4,"text-anchor":"end"},svg); tx.textContent=fmtV(v,"").trim();}
      var ticks=5; for(var j=0;j<=ticks;j++){var t=Math.round(xmax*j/ticks);var tx2=el("text",{x:X(t),y:H-6,"text-anchor":j===0?"start":j===ticks?"end":"middle"},svg);tx2.textContent=fmtT(t);}
      if(cfg.ref!=null){var ry=Y(cfg.ref);el("line",{x1:m.l,x2:W-m.r,y1:ry,y2:ry,stroke:"var(--muted)","stroke-width":1.5,"stroke-dasharray":"6 4"},svg);
        var rl=el("text",{x:W-m.r,y:ry-6,"text-anchor":"end"},svg); rl.textContent="target "+cfg.ref+" ms";}
      cfg.lines.forEach(function(l){
        var d="",pen=false; series.forEach(function(p){var v=p[l.key]; if(v==null){pen=false;return;} d+=(pen?"L":"M")+X(p.t).toFixed(1)+","+Y(v).toFixed(1); pen=true;});
        el("path",{d:d,fill:"none",stroke:l.color,"stroke-width":2,"stroke-linejoin":"round","stroke-linecap":"round"},svg);
      });
      if(cfg.lines.length>1){ // direct labels at line ends
        var last=series[series.length-1];
        cfg.lines.forEach(function(l){var v=last[l.key]; if(v==null) return; var t=el("text",{x:X(last.t)-4,y:Y(v)-6,"text-anchor":"end"},svg); t.textContent=l.short;});
      }
      var cross=el("line",{x1:0,x2:0,y1:m.t,y2:m.t+ih,stroke:"var(--muted)","stroke-width":1,visibility:"hidden"},svg);
      var dots=cfg.lines.map(function(l){return el("circle",{r:4,fill:l.color,stroke:"var(--bg)","stroke-width":2,visibility:"hidden"},svg)});
      var hit=el("rect",{x:m.l,y:m.t,width:iw,height:ih,fill:"transparent",tabindex:0},svg);
      function show(idx){
        var p=series[idx], x=X(p.t); cross.setAttribute("x1",x); cross.setAttribute("x2",x); cross.setAttribute("visibility","visible");
        tip.innerHTML=""; var h=document.createElement("div"); h.className="t"; h.textContent=fmtT(p.t)+" · "+p.users+" users"; tip.appendChild(h);
        cfg.lines.forEach(function(l,k){var v=p[l.key];
          if(v==null){dots[k].setAttribute("visibility","hidden");}else{dots[k].setAttribute("cx",x);dots[k].setAttribute("cy",Y(v));dots[k].setAttribute("visibility","visible");}
          var row=document.createElement("div"); row.className="row"; var key=document.createElement("i"); key.className="key"; key.style.background=l.color;
          var b=document.createElement("b"); b.textContent=fmtV(v,cfg.unit); var s=document.createElement("span"); s.textContent=l.label;
          row.appendChild(key); row.appendChild(b); row.appendChild(s); tip.appendChild(row);});
        if(cfg.ref!=null){var rr=document.createElement("div"); rr.className="row"; var sp=document.createElement("span"); sp.textContent="target "+cfg.ref+" ms"; rr.appendChild(sp); tip.appendChild(rr);}
        tip.style.display="block";
        var scale=host.clientWidth/W, left=host.offsetLeft+x*scale+12;
        if(left+tip.offsetWidth>card.clientWidth-8) left=host.offsetLeft+x*scale-tip.offsetWidth-12;
        tip.style.left=Math.max(4,left)+"px"; tip.style.top=(host.offsetTop+8)+"px";
      }
      function hide(){cross.setAttribute("visibility","hidden"); dots.forEach(function(d){d.setAttribute("visibility","hidden")}); tip.style.display="none";}
      function nearest(clientX){var r=svg.getBoundingClientRect(); var t=((clientX-r.left)*(W/r.width)-m.l)/iw*xmax; var best=0,bd=1e18;
        series.forEach(function(p,i){var dd=Math.abs(p.t-t); if(dd<bd){bd=dd;best=i;}}); return best;}
      var cur=-1;
      hit.addEventListener("pointermove",function(e){cur=nearest(e.clientX); show(cur);});
      hit.addEventListener("pointerleave",hide);
      hit.addEventListener("focus",function(){cur=series.length-1; show(cur);});
      hit.addEventListener("blur",hide);
      hit.addEventListener("keydown",function(e){if(e.key==="ArrowLeft"){cur=Math.max(0,cur-1);show(cur);e.preventDefault();}if(e.key==="ArrowRight"){cur=Math.min(series.length-1,cur+1);show(cur);e.preventDefault();}});
    }
    draw(); var rt; window.addEventListener("resize",function(){clearTimeout(rt); rt=setTimeout(draw,120);});
    if(window.__svdRedraw) window.__svdRedraw(function(){ if(host.clientWidth) draw(); });
  }
  // Tooltip helper shared by the bar charts: values lead, labels follow, all via textContent.
  function tipFor(card){var t=document.createElement("div"); t.className="tip"; card.appendChild(t); return t;}
  function fillTip(tip,title,rows){
    tip.innerHTML=""; var h=document.createElement("div"); h.className="t"; h.textContent=title; tip.appendChild(h);
    rows.forEach(function(r){var row=document.createElement("div"); row.className="row";
      if(r.color){var k=document.createElement("i"); k.className="key"; k.style.background=r.color; k.style.height="8px"; k.style.width="8px"; k.style.borderRadius="2px"; row.appendChild(k);}
      var b=document.createElement("b"); b.textContent=r.value; var s=document.createElement("span"); s.textContent=r.label;
      row.appendChild(b); row.appendChild(s); tip.appendChild(row);});
    tip.style.display="block";
  }
  // Exact locations behind a chart segment: file:line (or package@version) and the issue title.
  function whereList(tip,w,isLib){
    var box=document.createElement("div"); box.className="where";
    var h=document.createElement("div"); h.className="wh"; h.textContent=isLib?"Which libraries":"Where"; box.appendChild(h);
    w.items.forEach(function(it){var d=document.createElement("div"); d.className="wi";
      var c=document.createElement("code"); c.textContent=it.where; var t=document.createElement("span"); t.textContent=it.title;
      d.appendChild(c); d.appendChild(t); box.appendChild(d);});
    if(w.more){var m=document.createElement("div"); m.className="wm"; m.textContent="+ "+w.more+" more in the Security tab"; box.appendChild(m);}
    var f=document.createElement("div"); f.className="wf"; f.textContent="Click to open the Security tab"; box.appendChild(f);
    tip.appendChild(box);
  }
  function placeTip(tip,card,e){var r=card.getBoundingClientRect(), x=e.clientX-r.left+14, y=e.clientY-r.top+14;
    if(x+tip.offsetWidth>card.clientWidth-8) x=e.clientX-r.left-tip.offsetWidth-14;
    tip.style.left=Math.max(4,x)+"px"; tip.style.top=y+"px";}
  // A bar: square at the baseline, 4px rounded at the data end.
  function barPath(x,y,w,h,r){r=Math.min(r,w/2,h/2); if(w<=0) return "";
    return "M"+x+","+y+"h"+(w-r)+"a"+r+","+r+" 0 0 1 "+r+","+r+"v"+(h-2*r)+"a"+r+","+r+" 0 0 1 -"+r+","+r+"h-"+(w-r)+"z";}

  // Horizontal bars, one series, optional target line. rows: [{label, value}]
  function hbar(host,cfg){
    if(!host||!cfg.rows||!cfg.rows.length) return;
    var card=host.parentElement, tip=tipFor(card);
    function draw(){
      host.innerHTML="";
      var W=Math.max(320,host.clientWidth), rowH=30, bh=18, m={l:Math.min(260,Math.round(W*0.34)),r:64,t:cfg.ref!=null?22:6,b:24};
      var H=m.t+m.b+rowH*cfg.rows.length, iw=W-m.l-m.r;
      var svg=el("svg",{viewBox:"0 0 "+W+" "+H,role:"img","aria-label":cfg.label},host);
      var max=cfg.max||niceMax(Math.max.apply(null,cfg.rows.map(function(r){return r.value}).concat([cfg.ref||0]))*1.05);
      function X(v){return m.l+iw*Math.min(v,max)/max}
      for(var i=0;i<=4;i++){var v=max*i/4,x=X(v);
        el("line",{x1:x,x2:x,y1:m.t,y2:H-m.b,stroke:i===0?"var(--axis)":"var(--grid)","stroke-width":1},svg);
        var tx=el("text",{x:x,y:H-6,"text-anchor":i===0?"start":i===4?"end":"middle"},svg); tx.textContent=fmtV(v,"")+(cfg.suffix||"");}
      cfg.rows.forEach(function(r,i){
        var y=m.t+i*rowH+(rowH-bh)/2, g=el("g",{"class":"r"},svg);
        var lab=el("text",{x:m.l-10,y:y+bh/2+4,"text-anchor":"end",style:"fill:var(--muted)"},g);
        var name=r.label, maxc=Math.max(8,Math.floor((m.l-16)/7.2)); lab.textContent=name.length>maxc?"…"+name.slice(-(maxc-1)):name;
        el("path",{"class":"bar",d:barPath(m.l,y,Math.max(2,X(r.value)-m.l),bh,4),fill:cfg.color||"var(--series-1)"},g);
        var vt=el("text",{x:X(r.value)+6,y:y+bh/2+4,style:"fill:var(--ink)"},g); vt.textContent=fmtV(r.value,"")+(cfg.suffix||"");
        var hit=el("rect",{x:0,y:m.t+i*rowH,width:W,height:rowH,fill:"transparent",tabindex:0},g);
        function show(e){fillTip(tip,r.label,[{value:fmtV(r.value,"")+(cfg.suffix||""),label:cfg.valueLabel}].concat(cfg.ref!=null?[{value:fmtV(cfg.ref,"")+(cfg.suffix||""),label:"target"}]:[]));
          if(e&&e.clientX!=null) placeTip(tip,card,e); else {tip.style.left="8px"; tip.style.top=(host.offsetTop+y)+"px";}}
        hit.addEventListener("pointermove",show); hit.addEventListener("pointerleave",function(){tip.style.display="none"});
        hit.addEventListener("focus",function(){show(null)}); hit.addEventListener("blur",function(){tip.style.display="none"});
      });
      if(cfg.ref!=null){var rx=X(cfg.ref); el("line",{x1:rx,x2:rx,y1:m.t-4,y2:H-m.b,stroke:"var(--ink)","stroke-width":1.5},svg);
        var rl=el("text",{x:rx,y:m.t-8,"text-anchor":rx>W-120?"end":"middle",style:"fill:var(--muted)"},svg); rl.textContent="target "+cfg.ref+(cfg.suffix||"");}
    }
    draw(); var rt; window.addEventListener("resize",function(){clearTimeout(rt); rt=setTimeout(draw,120);});
    if(window.__svdRedraw) window.__svdRedraw(function(){ if(host.clientWidth) draw(); });
  }

  // Stacked horizontal bars by severity (status colours, 2px surface gap between segments).
  function stack(host,cfg){
    if(!host) return;
    var card=host.parentElement, tip=tipFor(card);
    function draw(){
      host.innerHTML="";
      var W=Math.max(320,host.clientWidth), rowH=44, bh=22, m={l:120,r:70,t:6,b:24};
      var H=m.t+m.b+rowH*cfg.rows.length, iw=W-m.l-m.r;
      var totals=cfg.rows.map(function(r){return cfg.keys.reduce(function(a,k){return a+(r.counts[k.key]||0)},0)});
      var max=niceMax(Math.max.apply(null,totals.concat([1])));
      function X(v){return m.l+iw*v/max}
      var svg=el("svg",{viewBox:"0 0 "+W+" "+H,role:"img","aria-label":cfg.label},host);
      for(var i=0;i<=4;i++){var v=max*i/4,x=X(v);
        el("line",{x1:x,x2:x,y1:m.t,y2:H-m.b,stroke:i===0?"var(--axis)":"var(--grid)","stroke-width":1},svg);
        var tx=el("text",{x:x,y:H-6,"text-anchor":i===0?"start":i===4?"end":"middle"},svg); tx.textContent=Math.round(v).toLocaleString();}
      cfg.rows.forEach(function(r,i){
        var y=m.t+i*rowH+(rowH-bh)/2, x=m.l;
        var lab=el("text",{x:m.l-10,y:y+bh/2+4,"text-anchor":"end",style:"fill:var(--ink)"},svg); lab.textContent=r.label;
        var segs=cfg.keys.filter(function(k){return r.counts[k.key]>0});
        segs.forEach(function(k,j){
          var w=X(r.counts[k.key])-m.l, last=j===segs.length-1, gap=last?0:2;
          var g=el("g",{"class":"r"},svg);
          el(last?"path":"rect",last?{"class":"bar",d:barPath(x,y,Math.max(1,w),bh,4),fill:k.color}:{"class":"bar",x:x,y:y,width:Math.max(1,w-gap),height:bh,fill:k.color},g);
          var hit=el("rect",{x:x,y:y-6,width:Math.max(6,w),height:bh+12,fill:"transparent",tabindex:0},g);
          var w8=(r.where||{})[k.key];
          function show(e){fillTip(tip,r.label,[{color:k.color,value:r.counts[k.key].toLocaleString(),label:k.label+(r.counts[k.key]===1?" issue":" issues")}]);
            if(w8) whereList(tip,w8,r.label==="Libraries");
            if(e&&e.clientX!=null) placeTip(tip,card,e); else {tip.style.left="8px"; tip.style.top=(host.offsetTop+y+bh+8)+"px";}}
          hit.style.cursor="pointer";
          hit.setAttribute("aria-label",r.label+": "+r.counts[k.key]+" "+k.label+". Opens the Security tab.");
          hit.addEventListener("click",function(){location.hash="security";});
          hit.addEventListener("keydown",function(ev){if(ev.key==="Enter"||ev.key===" "){ev.preventDefault();location.hash="security";}});
          hit.addEventListener("pointermove",show); hit.addEventListener("pointerleave",function(){tip.style.display="none"});
          hit.addEventListener("focus",function(){show(null)}); hit.addEventListener("blur",function(){tip.style.display="none"});
          x+=w;
        });
        var tt=el("text",{x:(segs.length?x:m.l)+8,y:y+bh/2+4,style:"fill:var(--ink);font-weight:700"},svg);
        tt.textContent=totals[i]?totals[i].toLocaleString():(r.notRun?"didn't run":"none");
      });
    }
    draw(); var rt; window.addEventListener("resize",function(){clearTimeout(rt); rt=setTimeout(draw,120);});
    if(window.__svdRedraw) window.__svdRedraw(function(){ if(host.clientWidth) draw(); });
  }

  var SEV=[{key:"critical",label:"critical",color:"var(--critical)"},{key:"high",label:"high",color:"var(--serious)"},
           {key:"medium",label:"medium",color:"var(--warning)"},{key:"low",label:"low",color:"var(--faint)"}];
  if(data.severity) stack(document.getElementById("chartSeverity"),{label:"Security findings by severity",keys:SEV,rows:data.severity});
  if(data.coverage&&data.coverage.length>1) hbar(document.getElementById("chartCoverage"),{label:"Least-covered files",rows:data.coverage,
    max:100,suffix:"%",ref:data.coverageTarget,valueLabel:"covered"});
  if(data.endpoints&&data.endpoints.length>1) hbar(document.getElementById("chartEndpoints"),{label:"p95 response time by endpoint",rows:data.endpoints,
    suffix:" ms",ref:data.target,valueLabel:"p95",color:"var(--series-1)"});
  if(!series.length) return;
  lineChart(document.getElementById("chartLatency"),{label:"Response time over the run",unit:"ms",ref:data.target,
    lines:[{key:"p50",label:"p50 (median)",short:"p50",color:"var(--series-1)"},{key:"p95",label:"p95",short:"p95",color:"var(--series-2)"}]});
  lineChart(document.getElementById("chartRps"),{label:"Requests and failures per second",unit:"/s",
    lines:[{key:"rps",label:"requests/s",short:"req/s",color:"var(--series-1)"},{key:"fps",label:"failures/s",short:"fail/s",color:"var(--series-2)"}]});
  lineChart(document.getElementById("chartUsers"),{label:"Simulated users over the run",unit:"users",
    lines:[{key:"users",label:"users",short:"users",color:"var(--series-1)"}]});
})();
</script>
</body>
</html>
